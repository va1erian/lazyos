# The Terminal's terminfo entry (docs/terminal-plan.md T5), compiled at build
# time by libs/terminfo into /system/share/terminfo/x/xterm-256color.
#
# It is xterm-256color trimmed to what lazyterm implements, and nothing else:
# no alternate character set (acsc/smacs: ESC ( 0 is not implemented, so
# ncurses falls back to ASCII or Unicode box drawing), no insert mode, no
# blink, no 8-bit controls. Every capability below is a sequence lazyterm
# parses (xui-app/crates/term/src/handler.rs) or a key it sends
# (xui-app/crates/term/src/keys.rs); host tests keep the two in step.
xterm-256color|xterm with 256 colors (LazyOS Terminal),
	am, bce, msgr, xenl,
	colors#0x100, cols#80, it#8, lines#24, pairs#0x7fff,
	bel=^G, cr=^M, ind=^J, cud1=^J, cub1=^H, ht=^I,
	cbt=\E[Z, hts=\EH, tbc=\E[3g,
	clear=\E[H\E[2J, ed=\E[J, el=\E[K, el1=\E[1K, home=\E[H,
	cup=\E[%i%p1%d;%p2%dH, hpa=\E[%i%p1%dG, vpa=\E[%i%p1%dd,
	cuu1=\E[A, cuf1=\E[C,
	cuu=\E[%p1%dA, cud=\E[%p1%dB, cuf=\E[%p1%dC, cub=\E[%p1%dD,
	csr=\E[%i%p1%d;%p2%dr, sc=\E7, rc=\E8, ri=\EM,
	indn=\E[%p1%dS, rin=\E[%p1%dT,
	dch1=\E[P, dch=\E[%p1%dP, ich=\E[%p1%d@, ech=\E[%p1%dX,
	dl1=\E[M, dl=\E[%p1%dM, il1=\E[L, il=\E[%p1%dL,
	smcup=\E[?1049h, rmcup=\E[?1049l,
	civis=\E[?25l, cnorm=\E[?25h, cvvis=\E[?25h,
	smam=\E[?7h, rmam=\E[?7l,
	sgr0=\E[m, bold=\E[1m, dim=\E[2m, sitm=\E[3m, ritm=\E[23m,
	smul=\E[4m, rmul=\E[24m, rev=\E[7m, smso=\E[7m, rmso=\E[27m, invis=\E[8m,
	op=\E[39;49m,
	setaf=\E[%?%p1%{8}%<%t3%p1%d%e%p1%{16}%<%t9%p1%{8}%-%d%e38\:5\:%p1%d%;m,
	setab=\E[%?%p1%{8}%<%t4%p1%d%e%p1%{16}%<%t10%p1%{8}%-%d%e48\:5\:%p1%d%;m,
	rs1=\Ec,
	u6=\E[%i%d;%dR, u7=\E[6n, u8=\E[?%[;0123456789]c, u9=\E[c,
	smkx=\E[?1h\E=, rmkx=\E[?1l\E>,
	kbs=^?, kcbt=\E[Z, kmous=\E[<,
	kcuu1=\EOA, kcud1=\EOB, kcuf1=\EOC, kcub1=\EOD,
	khome=\EOH, kend=\EOF, kich1=\E[2~, kdch1=\E[3~, kpp=\E[5~, knp=\E[6~,
	kf1=\EOP, kf2=\EOQ, kf3=\EOR, kf4=\EOS,
	kf5=\E[15~, kf6=\E[17~, kf7=\E[18~, kf8=\E[19~,
	kf9=\E[20~, kf10=\E[21~, kf11=\E[23~, kf12=\E[24~,
	kf13=\E[1;2P, kf14=\E[1;2Q, kf15=\E[1;2R, kf16=\E[1;2S,
	kf17=\E[15;2~, kf18=\E[17;2~, kf19=\E[18;2~, kf20=\E[19;2~,
	kf21=\E[20;2~, kf22=\E[21;2~, kf23=\E[23;2~, kf24=\E[24;2~,
	kf25=\E[1;5P, kf26=\E[1;5Q, kf27=\E[1;5R, kf28=\E[1;5S,
	kf29=\E[15;5~, kf30=\E[17;5~, kf31=\E[18;5~, kf32=\E[19;5~,
	kf33=\E[20;5~, kf34=\E[21;5~, kf35=\E[23;5~, kf36=\E[24;5~,
	kind=\E[1;2B, kri=\E[1;2A,
	kLFT=\E[1;2D, kRIT=\E[1;2C, kHOM=\E[1;2H, kEND=\E[1;2F,
	kDC=\E[3;2~, kIC=\E[2;2~, kNXT=\E[6;2~, kPRV=\E[5;2~,

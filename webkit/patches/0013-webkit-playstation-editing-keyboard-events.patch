+// The editing command a key press stands for: navigation and deletion in text, select all, the
+// clipboard, undo. The GTK and WPE ports leave this to the toolkit's input method, which a port
+// that only forwards key events (a UI process over WebKit's C API) does not have.
+static const char* editingCommandForKeyDown(const KeyboardEvent& event)
+{
+    if (event.altKey() || event.metaKey())
+        return nullptr;
+    const String& key = event.key();
+    const bool shift = event.shiftKey();
+    if (event.ctrlKey()) {
+        if (key == "a"_s || key == "A"_s)
+            return "SelectAll";
+        if (key == "c"_s || key == "C"_s)
+            return "Copy";
+        if (key == "x"_s || key == "X"_s)
+            return "Cut";
+        if (key == "v"_s || key == "V"_s)
+            return "Paste";
+        if (key == "z"_s || key == "Z"_s)
+            return shift ? "Redo" : "Undo";
+        if (key == "y"_s || key == "Y"_s)
+            return "Redo";
+        if (key == "ArrowLeft"_s)
+            return shift ? "MoveWordLeftAndModifySelection" : "MoveWordLeft";
+        if (key == "ArrowRight"_s)
+            return shift ? "MoveWordRightAndModifySelection" : "MoveWordRight";
+        if (key == "Backspace"_s)
+            return "DeleteWordBackward";
+        if (key == "Delete"_s)
+            return "DeleteWordForward";
+        if (key == "Home"_s)
+            return shift ? "MoveToBeginningOfDocumentAndModifySelection" : "MoveToBeginningOfDocument";
+        if (key == "End"_s)
+            return shift ? "MoveToEndOfDocumentAndModifySelection" : "MoveToEndOfDocument";
+        return nullptr;
+    }
+    if (key == "ArrowLeft"_s)
+        return shift ? "MoveLeftAndModifySelection" : "MoveLeft";
+    if (key == "ArrowRight"_s)
+        return shift ? "MoveRightAndModifySelection" : "MoveRight";
+    if (key == "ArrowUp"_s)
+        return shift ? "MoveUpAndModifySelection" : "MoveUp";
+    if (key == "ArrowDown"_s)
+        return shift ? "MoveDownAndModifySelection" : "MoveDown";
+    if (key == "Home"_s)
+        return shift ? "MoveToBeginningOfLineAndModifySelection" : "MoveToBeginningOfLine";
+    if (key == "End"_s)
+        return shift ? "MoveToEndOfLineAndModifySelection" : "MoveToEndOfLine";
+    if (key == "PageUp"_s)
+        return shift ? "MovePageUpAndModifySelection" : "MovePageUp";
+    if (key == "PageDown"_s)
+        return shift ? "MovePageDownAndModifySelection" : "MovePageDown";
+    if (key == "Backspace"_s)
+        return "DeleteBackward";
+    if (key == "Delete"_s)
+        return "DeleteForward";
+    return nullptr;
+}
+
+// What the toolkit's key bindings and input method do on other ports (and the Windows and Qt
+// ports of WebKit did here): a key down runs its editing command, a key press types its text.
 bool WebPage::handleEditingKeyboardEvent(WebCore::KeyboardEvent& event)
 {
-    notImplemented();
-    return false;
+    RefPtr frame = corePage()->focusController().focusedOrMainFrame();
+    if (!frame)
+        return false;
+    auto* keyEvent = event.underlyingPlatformEvent();
+    if (!keyEvent || keyEvent->isSystemKey())
+        return false;
+
+    if (keyEvent->type() == PlatformEvent::Type::RawKeyDown) {
+        const char* name = editingCommandForKeyDown(event);
+        if (!name)
+            return false;
+        auto command = frame->editor().command(String::fromUTF8(name));
+        // A command that inserts text is left to the key press that follows.
+        return !command.isTextInsertion() && command.execute(&event);
+    }
+
+    // Enter in a text area or an editable region is a line break; in a text field it is the form's
+    // (the default handler submits it).
+    if (event.charCode() == '\r') {
+        RefPtr focused = frame->document() ? frame->document()->focusedElement() : nullptr;
+        if (!frame->selection().selection().isContentEditable() || dynamicDowncast<HTMLInputElement>(focused.get()))
+            return false;
+        return frame->editor().command("InsertNewline"_s).execute(&event);
+    }
+    // Control characters (Tab, Backspace, Escape) are keys, not text.
+    if (event.charCode() < ' ')
+        return false;
+    return frame->editor().insertText(keyEvent->text(), &event);
 }
 

WebKit: the curl NetworkCache::Data can share a mapped file with another process.

A content rule list (ENABLE_CONTENT_EXTENSIONS, LazyWeb+'s ad blocker, issue #845) is compiled
into a file, mapped, and handed to the WebProcess and the NetworkProcess as shared memory:
API::createExtension (APIContentRuleListStore.cpp) asks the mapped NetworkCache::Data for
tryCreateSharedMemory(). The curl backend defines that only for Windows (a file mapping
handle), so WebKit's UI process did not link with content extensions on. The GLib backend
keeps the mapped file's descriptor next to the map and wraps both as SharedMemory; the curl
one dropped the descriptor in adoptMap. It now keeps it (m_fileHandle, as GLib's does) and
wraps the map the same way on Unix-domain-socket platforms (LazyOS), where SharedMemory::wrapMap
does not close the descriptor (the Data's handle does) and createHandle sends a duplicate.

--- a/Source/WebKit/NetworkProcess/cache/NetworkCacheData.h
+++ b/Source/WebKit/NetworkProcess/cache/NetworkCacheData.h
@@ -108,6 +108,8 @@
 #endif
 #if USE(CURL)
     Box<Variant<Vector<uint8_t>, FileSystem::MappedFileData>> m_buffer;
+    // LazyOS: kept with the map so it can be shared with another process (tryCreateSharedMemory).
+    Box<FileSystem::FileHandle> m_fileHandle;
 #endif
     bool m_isMap { false };
 };
--- a/Source/WebKit/NetworkProcess/cache/NetworkCacheDataCurl.cpp
+++ b/Source/WebKit/NetworkProcess/cache/NetworkCacheDataCurl.cpp
@@ -108,9 +108,11 @@
 Data Data::adoptMap(FileSystem::MappedFileData&& mappedFile, FileSystem::FileHandle&& fileHandle)
 {
     ASSERT(mappedFile);
-    fileHandle = { };
-
-    return { WTF::move(mappedFile) };
+    // LazyOS: the handle stays with the map, so the map can be shared with another process
+    // (tryCreateSharedMemory below: a content rule list travels to the web processes that way).
+    Data data { WTF::move(mappedFile) };
+    data.m_fileHandle = Box<FileSystem::FileHandle>::create(WTF::move(fileHandle));
+    return data;
 }
 
 #if ENABLE(SHAREABLE_RESOURCE) && OS(WINDOWS)
@@ -126,6 +128,19 @@
     return WebCore::SharedMemory::map({ WTF::move(newHandle), size() }, WebCore::SharedMemory::Protection::ReadOnly);
 }
 #endif
+
+#if USE(UNIX_DOMAIN_SOCKETS)
+RefPtr<WebCore::SharedMemory> Data::tryCreateSharedMemory() const
+{
+    if (isNull() || !isMap() || !m_fileHandle || !m_fileHandle->isValid())
+        return nullptr;
+
+    auto& mapped = std::get<FileSystem::MappedFileData>(*m_buffer);
+    // The wrapper does not close the descriptor (this Data's handle does); createHandle sends a
+    // duplicate to the process that maps it.
+    return WebCore::SharedMemory::wrapMap(const_cast<uint8_t*>(mapped.span().data()), mapped.size(), m_fileHandle->platformHandle());
+}
+#endif
 
 } // namespace NetworkCache
 } // namespace WebKit

+#if USE(UNIX_DOMAIN_SOCKETS)
+// LazyOS: the one kind of map that keeps its file's descriptor (read-only: mapFileForSharing opens it
+// so), for tryCreateSharedMemory below. Only content rule lists are mapped this way: every other map
+// closes its descriptor above, so a NetworkProcess holding cache entries mapped holds none (#892).
+Data Data::adoptMapForSharing(FileSystem::MappedFileData&& mappedFile, FileSystem::FileHandle&& fileHandle)
+{
+    ASSERT(mappedFile);
+    Data data { WTF::move(mappedFile) };
+    data.m_fileHandle = Box<FileSystem::FileHandle>::create(WTF::move(fileHandle));
+    return data;
+}
+
+Data mapFileForSharing(const String& path)
+{
+    auto handle = FileSystem::openFile(path, FileSystem::FileOpenMode::Read);
+    if (!handle)
+        return { };
+
+    auto size = handle.size();
+    if (!size)
+        return { };
+
+    if (!*size)
+        return Data::empty();
+
+    auto mappedFile = handle.map(FileSystem::MappedFileMode::Private);
+    if (!mappedFile)
+        return { };
+
+    return Data::adoptMapForSharing(WTF::move(*mappedFile), WTF::move(handle));
+}
+#endif
+
 #if ENABLE(SHAREABLE_RESOURCE) && OS(WINDOWS)
 RefPtr<WebCore::SharedMemory> Data::tryCreateSharedMemory() const
 {
@@ -127,5 +160,21 @@
 }
 #endif
 
+#if USE(UNIX_DOMAIN_SOCKETS)
+// The SharedMemory wraps this Data's map and read-only descriptor (createHandle sends a duplicate of
+// it to the process that maps it) and neither unmaps nor closes them, so it must not outlive the Data:
+// API::ContentRuleList, the one owner of both, destroys the compiled list holding it first (its members'
+// order, APIContentRuleList.h in this patch). A map that does not keep its descriptor (anything but a
+// content rule list) cannot be shared.
+RefPtr<WebCore::SharedMemory> Data::tryCreateSharedMemory() const
+{
+    if (isNull() || !isMap() || !m_fileHandle || !m_fileHandle->isValid())
+        return nullptr;
+
+    auto& mapped = std::get<FileSystem::MappedFileData>(*m_buffer);
+    return WebCore::SharedMemory::wrapMap(const_cast<uint8_t*>(mapped.span().data()), mapped.size(), m_fileHandle->platformHandle());
+}
+#endif
+
 } // namespace NetworkCache
 } // namespace WebKit

+static WKPageUpdateCallback s_updateCallback;
+static void* s_updateCallbackContext;
+
+static void forwardUpdate(WebKit::WebPageProxy& page, const WebCore::IntRect& scrollRect, const WebCore::IntSize& scrollOffset, std::span<const WebCore::IntRect> updateRects, float deviceScaleFactor, void*)
+{
+    auto callback = s_updateCallback;
+    if (!callback)
+        return;
+    auto wkRect = [](const WebCore::IntRect& r) { return WKRectMake(r.x(), r.y(), r.width(), r.height()); };
+    if (deviceScaleFactor != 1) {
+        callback(WebKit::toAPI(&page), WKRectMake(0, 0, 0, 0), WKSizeMake(0, 0), nullptr, 0, s_updateCallbackContext);
+        return;
+    }
+    std::vector<WKRect> rects;
+    rects.reserve(updateRects.size());
+    for (const auto& rect : updateRects)
+        rects.push_back(wkRect(rect));
+    callback(WebKit::toAPI(&page), wkRect(scrollRect), WKSizeMake(scrollOffset.width(), scrollOffset.height()), rects.data(), rects.size(), s_updateCallbackContext);
+}
+#endif
+
+void WKPageSetUpdateCallback(WKPageRef, WKPageUpdateCallback callback, void* context)
+{
+#if !USE(GRAPHICS_LAYER_WC)
+    s_updateCallback = callback;
+    s_updateCallbackContext = context;
+    WebKit::setDrawingAreaUpdateObserver(callback ? forwardUpdate : nullptr, nullptr);
+#else
+    UNUSED_PARAM(callback);
+    UNUSED_PARAM(context);
+#endif
+}
 

+// WKEventModifiers (shift 1, control 2, alt 4, meta 8) as libwpe's keyboard modifiers.
+static uint32_t wpeKeyboardModifiers(uint32_t modifiers)
+{
+    uint32_t wpe = 0;
+    if (modifiers & kWKEventModifiersControlKey)
+        wpe |= wpe_input_keyboard_modifier_control;
+    if (modifiers & kWKEventModifiersShiftKey)
+        wpe |= wpe_input_keyboard_modifier_shift;
+    if (modifiers & kWKEventModifiersAltKey)
+        wpe |= wpe_input_keyboard_modifier_alt;
+    if (modifiers & kWKEventModifiersMetaKey)
+        wpe |= wpe_input_keyboard_modifier_meta;
+    return wpe;
+}
+
+// The pointer modifiers: the keyboard ones, and the button that is down (a move with a
+// button held is a drag, which WebKit only knows from the modifiers).
+static uint32_t wpePointerModifiers(uint32_t modifiers, WKEventMouseButton heldButton)
+{
+    uint32_t wpe = wpeKeyboardModifiers(modifiers);
+    switch (heldButton) {
+    case kWKEventMouseButtonLeftButton:
+        wpe |= wpe_input_pointer_modifier_button1;
+        break;
+    case kWKEventMouseButtonRightButton:
+        wpe |= wpe_input_pointer_modifier_button2;
+        break;
+    case kWKEventMouseButtonMiddleButton:
+        wpe |= wpe_input_pointer_modifier_button3;
+        break;
+    default:
+        break;
+    }
+    return wpe;
+}
+
+// Events carry a time: double-click detection compares it, so it must move.
+static uint32_t eventTime()
+{
+    return static_cast<uint32_t>(MonotonicTime::now().secondsSinceEpoch().milliseconds());
+}

+namespace WebKit {
+using PageWheelObserver = void (*)(WebPageProxy&, size_t);
+void setPageWheelObserver(PageWheelObserver);
+}
+
+static WKPageWheelDoneCallback s_wheelDoneCallback;
+static void* s_wheelDoneCallbackContext;
+
+static void forwardWheelDone(WebKit::WebPageProxy& page, size_t pending)
+{
+    if (auto callback = s_wheelDoneCallback)
+        callback(WebKit::toAPI(&page), pending, s_wheelDoneCallbackContext);
+}
+
+void WKPageSetWheelDoneCallback(WKPageRef, WKPageWheelDoneCallback callback, void* context)
+{
+    s_wheelDoneCallback = callback;
+    s_wheelDoneCallbackContext = context;
+    WebKit::setPageWheelObserver(callback ? forwardWheelDone : nullptr);
+}

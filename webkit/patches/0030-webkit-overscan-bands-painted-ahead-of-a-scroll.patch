+#if PLATFORM(LAZYOS)
+// ---- overscan bands (patch 0030) ----------------------------------------------------------------------
+//
+// The window shows the picture ahead of this process while it scrolls: it answers the wheel at once, and
+// this process tens or hundreds of milliseconds later. What that uncovers it can only show if it has it:
+// these are the rows of the document above and below the view, painted here whenever there is nothing
+// else to paint, a chunk at a time (the main thread also runs the page), nearest the view and in the
+// direction of the last scroll first, and sent as updates of their own. Repaints that land in them
+// (ScrollView reports them that far out) mark them stale; stale bands are repainted at most every
+// kDirtyBandInterval. A band is a preview: once the view gets there it is painted as always.
+
+// Pixels a chunk of band may hold: about 5-10 ms of painting a busy page on the machines this runs on.
+static constexpr int kBandChunkPixels = 512 * 1024;
+static constexpr Seconds kDirtyBandInterval = 500_ms;
+// A region with more rectangles than this is replaced by its bounds (a Region gets slow).
+static constexpr size_t kMaxBandDirtyRects = 32;
+
+void DrawingAreaCoordinatedGraphics::updateOverscan()
+{
+    int rows = 0;
+    if (m_overscanViewports > 0 && m_webPage->corePage()->deviceScaleFactor() == 1)
+        rows = static_cast<int>(m_webPage->size().height() * m_overscanViewports);
+    m_overscan = std::max(rows, 0);
+    WebCore::setMainScrollViewRepaintOverscan(m_overscan);
+}
+
+void DrawingAreaCoordinatedGraphics::noteBandDamage(const IntRect& rect)
+{
+    if (m_overscan <= 0 || m_layerTreeHost)
+        return;
+    IntRect bounds = m_webPage->bounds();
+    IntRect zone = bounds;
+    zone.inflateY(m_overscan);
+    IntRect band = intersection(rect, zone);
+    if (band.isEmpty() || bounds.contains(band))
+        return;
+    RefPtr view = m_webPage->localMainFrameView();
+    if (!view)
+        return;
+    Region outside(band);
+    outside.subtract(bounds);
+    outside.translate(toIntSize(view->scrollPosition()));
+    m_bandDirty.unite(outside);
+    if (m_bandDirty.rects().size() > kMaxBandDirtyRects)
+        m_bandDirty = Region(m_bandDirty.bounds());
+    scheduleBands();
+}
+
+void DrawingAreaCoordinatedGraphics::invalidateBands()
+{
+    if (m_overscan <= 0)
+        return;
+    m_bandDirty.unite(m_bandValid);
+    if (m_bandDirty.rects().size() > kMaxBandDirtyRects)
+        m_bandDirty = Region(m_bandDirty.bounds());
+    scheduleBands();
+}
+
+void DrawingAreaCoordinatedGraphics::scheduleBands(Seconds delay)
+{
+    if (m_overscan <= 0 || m_layerTreeHost)
+        return;
+    if (m_bandTimer.isActive() && delay > 0_s)
+        return;
+    m_bandTimer.startOneShot(delay);
+}
+
+void DrawingAreaCoordinatedGraphics::bandTimerFired()
+{
+    if (m_overscan <= 0 || m_layerTreeHost || m_isPaintingSuspended || m_layerTreeStateIsFrozen || m_inUpdateGeometry)
+        return;
+    if (m_isWaitingForDidUpdate || !m_dirtyRegion.isEmpty() || m_displayTimer.isActive()) {
+        // The view comes first; the bands wait for the next DidUpdate.
+        m_bandsWanted = true;
+        return;
+    }
+    paintBand();
 }
 
+// The part of `todo` to paint next: the rectangle nearest the view (those in the direction of the last
+// scroll first), cut to `rows` rows on the side that faces the view.
+static IntRect nextBandChunk(const Region& todo, int viewTop, int viewBottom, int direction, int overscan, int rows)
+{
+    IntRect best;
+    int bestKey = std::numeric_limits<int>::max();
+    for (auto& rect : todo.rects()) {
+        bool below = rect.y() >= viewBottom;
+        int distance = below ? rect.y() - viewBottom : viewTop - rect.maxY();
+        bool ahead = below == (direction > 0);
+        int key = std::max(distance, 0) + (ahead ? 0 : overscan / 2);
+        if (key >= bestKey)
+            continue;
+        bestKey = key;
+        best = rect;
+        int height = std::min(rect.height(), rows);
+        if (!below)
+            best.setY(rect.maxY() - height);
+        best.setHeight(height);
+    }
+    return best;
+}
+
+bool DrawingAreaCoordinatedGraphics::paintBand()
+{
+    Ref webPage = m_webPage.get();
+    RefPtr view = webPage->localMainFrameView();
+    IntSize size = webPage->size();
+    if (!view || size.isEmpty() || view->needsLayout() || !view->layoutContext().inPaintableState())
+        return false;
+
+    IntPoint position = view->scrollPosition();
+    if (position.x() != m_bandScrollX) {
+        m_bandValid = Region();
+        m_bandDirty = Region();
+        m_bandScrollX = position.x();
+    }
+    if (position.y() != m_bandScrollY) {
+        m_bandDirection = position.y() > m_bandScrollY ? 1 : -1;
+        m_bandScrollY = position.y();
+    }
+
+    // What the window may need next: up to m_overscan rows on either side of the view, inside the document.
+    const int viewTop = position.y();
+    const int viewBottom = position.y() + size.height();
+    const int aboveTop = std::max(0, viewTop - m_overscan);
+    const int belowHeight = std::clamp(view->contentsHeight() - viewBottom, 0, m_overscan);
+    Region wanted;
+    if (viewTop > aboveTop)
+        wanted.unite(IntRect(position.x(), aboveTop, size.width(), viewTop - aboveTop));
+    if (belowHeight > 0)
+        wanted.unite(IntRect(position.x(), viewBottom, size.width(), belowHeight));
+    m_bandValid.intersect(wanted);
+    m_bandDirty.intersect(m_bandValid);
+
+    Region todo = wanted;
+    todo.subtract(m_bandValid);
+    bool repaint = false;
+    if (todo.isEmpty()) {
+        if (m_bandDirty.isEmpty()) {
+            m_inDirtyBandPass = false;
+            return false;
+        }
+        if (!m_inDirtyBandPass) {
+            auto due = m_lastDirtyBandPaint + kDirtyBandInterval;
+            auto now = MonotonicTime::now();
+            if (now < due) {
+                scheduleBands(due - now);
+                return false;
+            }
+            m_inDirtyBandPass = true;
+        }
+        todo = m_bandDirty;
+        repaint = true;
+    }
+
+    const int rows = std::clamp(kBandChunkPixels / std::max(size.width(), 1), 32, 1024);
+    IntRect chunk = nextBandChunk(todo, viewTop, viewBottom, m_bandDirection, m_overscan, rows);
+    if (chunk.isEmpty())
+        return false;
+
+    auto bitmap = ShareableBitmap::create({ chunk.size() });
+    if (!bitmap)
+        return false;
+    auto handle = bitmap->createHandle();
+    if (!handle)
+        return false;
+    auto context = bitmap->createGraphicsContext();
+    if (!context)
+        return false;
+    {
+        // Document coordinates, as ScrollView::paint hands them to paintContents.
+        GraphicsContextStateSaver saver(*context);
+        context->translate(-chunk.x(), -chunk.y());
+        context->clip(chunk);
+        view->paintContents(*context, chunk);
+    }
+
+    UpdateInfo updateInfo;
+    updateInfo.viewSize = size;
+    updateInfo.deviceScaleFactor = 1;
+    updateInfo.updateRectBounds = IntRect(IntPoint(), chunk.size());
+    updateInfo.updateRects.append(updateInfo.updateRectBounds);
+    updateInfo.bitmapHandle = WTF::move(*handle);
+    updateInfo.documentRect = chunk;
+    send(Messages::DrawingAreaProxy::Update(0, WTF::move(updateInfo)));
+    m_isWaitingForDidUpdate = true;
+
+    m_bandValid.unite(chunk);
+    m_bandDirty.subtract(chunk);
+    if (repaint && m_bandDirty.isEmpty()) {
+        m_inDirtyBandPass = false;
+        m_lastDirtyBandPaint = MonotonicTime::now();
+    }
+    // The next chunk follows the DidUpdate for this one.
+    scheduleBands();
+    return true;
+}
+#endif

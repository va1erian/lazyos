+#if PLATFORM(LAZYOS)
+// LazyOS: the parts of a fixed layer's repaint rect that something is painted into: the rects of the
+// layers in its (non-composited) subtree that paint anything. A page often has fixed layers that cover
+// the whole view and paint nothing themselves (an overlay's container, a hidden consent dialog's frame,
+// an ad slot): their whole rect is not what a scroll must repaint, only what is painted in it.
+static void addPaintedRepaintRects(const RenderLayer& layer, LayoutRect& rect)
+{
+    if (layer.hasVisibleContent() && layer.isVisuallyNonEmpty()) {
+        // What it paints, and its subtree with it (a superset, never less).
+        rect.uniteIfNonZero(layer.repaintRectIncludingNonCompositingDescendants());
+        return;
+    }
+    for (auto* child = layer.firstChild(); child; child = child->nextSibling()) {
+        if (!child->isComposited())
+            addPaintedRepaintRects(*child, rect);
+    }
+}
+#endif

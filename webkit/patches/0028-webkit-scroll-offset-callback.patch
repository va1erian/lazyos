+namespace WebKit {
+using PageScrollObserver = void (*)(WebPageProxy&, const WebCore::IntPoint&);
+void setPageScrollObserver(PageScrollObserver);
+}
+
+static WKPageScrollOffsetCallback s_scrollOffsetCallback;
+static void* s_scrollOffsetCallbackContext;
+
+static void forwardScrollOffset(WebKit::WebPageProxy& page, const WebCore::IntPoint& offset)
+{
+    if (auto callback = s_scrollOffsetCallback)
+        callback(WebKit::toAPI(&page), offset.x(), offset.y(), s_scrollOffsetCallbackContext);
+}
+
+void WKPageSetScrollOffsetCallback(WKPageRef, WKPageScrollOffsetCallback callback, void* context)
+{
+    s_scrollOffsetCallback = callback;
+    s_scrollOffsetCallbackContext = context;
+    WebKit::setPageScrollObserver(callback ? forwardScrollOffset : nullptr);
+}

+
+namespace WebKit {
+unsigned long long lazyosPaintStats[8];
+
+unsigned long long lazyosPaintClock()
+{
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return static_cast<unsigned long long>(now.tv_sec) * 1000000ULL + static_cast<unsigned long long>(now.tv_nsec) / 1000ULL;
+}
+}
+
+void WKPageGetPaintStats(unsigned long long* out, int count)
+{
+    for (int i = 0; out && i < count && i < 8; ++i)
+        out[i] = WebKit::lazyosPaintStats[i];
+}
 

<?xml version="1.0"?>
<!-- Fontconfig for WebKit's processes on LazyOS (docs/webkit-port-plan.md W4).
     A template: tools/webkit/fhspaths.py fills in the paths marked with at-signs from libs/fhs and
     tools/webkit/port_cmake.py writes the result to target/webkit/fonts.conf, which the image
     build (LAZYOS_LAZYWEBPLUS=1) installs at fhs::etc::FONTS_CONF; the W3 Fontconfig was built to
     read /system/etc and to cache in the same cache directory. -->
<fontconfig>
  <!-- The fonts the image ships: the Liberation family and anything a user or package adds. -->
  <dir>@FONT_DIR@</dir>
  <cachedir>@FONT_CACHE_DIR@</cachedir>

  <!-- Liberation is metric-compatible with the faces a web page names first, and is the
       only family the image ships, so the generic families and those names resolve to it. -->
  <alias binding="same"><family>sans-serif</family><prefer><family>Liberation Sans</family></prefer></alias>
  <alias binding="same"><family>serif</family><prefer><family>Liberation Serif</family></prefer></alias>
  <alias binding="same"><family>monospace</family><prefer><family>Liberation Mono</family></prefer></alias>
  <alias binding="same"><family>system-ui</family><prefer><family>Liberation Sans</family></prefer></alias>
  <alias binding="same"><family>Arial</family><prefer><family>Liberation Sans</family></prefer></alias>
  <alias binding="same"><family>Helvetica</family><prefer><family>Liberation Sans</family></prefer></alias>
  <alias binding="same"><family>Times New Roman</family><prefer><family>Liberation Serif</family></prefer></alias>
  <alias binding="same"><family>Times</family><prefer><family>Liberation Serif</family></prefer></alias>
  <alias binding="same"><family>Courier New</family><prefer><family>Liberation Mono</family></prefer></alias>
  <alias binding="same"><family>Courier</family><prefer><family>Liberation Mono</family></prefer></alias>
</fontconfig>

/// The system input service (`inputd`; `docs/input-plan.md`).
///
/// Two interfaces, served on one endpoint and registered under both names:
/// `os.lazy.input.v1` for any client that wants keystrokes and
/// `os.lazy.input.shell.v1` for the compositor. Input is deliberately not part
/// of `os.lazy.display.v1`: display is about surfaces and buffers, input has its
/// own authorisation and versioning, and `display.v1`'s frozen `KeyDown`/`KeyUp`
/// (8/9) are synthesised by the compositor for legacy surfaces only.
///
/// **Keys and text are separate streams.** `KeyEvent` reports the *physical*
/// key (`code`, a USB HID usage from page 0x07, identical on every layout) plus
/// its meaning under the active layout (`sym`); it is what games, shortcuts and
/// terminals want. `TextInput` carries composed characters for text widgets and
/// is sent only for character-producing presses (never for Ctrl/Alt/Super
/// chords). Neither has to reverse-engineer the other.
///
/// Events go from `inputd` straight to the endpoint the client transferred in
/// `Open`, only while that client's surface has keyboard focus, and only to
/// that client.
///
/// Failures of calls are returned as a structured error field (id 15,
/// errno-style code plus friendly text) instead of the declared reply fields.
interface os.lazy.input.v1 {
    /// Open an input session bound to the calling task (the kernel-stamped
    /// sender). `surface` names the window it wants keys for: it must be a
    /// surface the compositor registered as owned by this same task, so a
    /// client can never claim someone else's window (`EACCES`; `ENOENT` when
    /// the compositor has not registered it); an absent `surface` is reserved for
    /// the login console and refused with `EINVAL` for now. The parcel transfers the event
    /// endpoint (`handles[0]`) that receives every event below. A task may hold
    /// several sessions, one per surface.
    method Open(surface: Option<U64>) -> (session: U64) = 1;
    /// End a session. Only the task that opened it may.
    method Close(session: U64) -> () = 2;
    /// The current layout name, modifier and lock bits (`mods` as in
    /// `KeyEvent`) and the key-repeat timing in milliseconds.
    method GetState() -> (layout: String, mods: U32, repeat_delay_ms: U32, repeat_interval_ms: U32) = 3;
    /// Event: a key changed state. `code` is the physical key, `sym` its
    /// keysym under the active layout (a Unicode scalar for character keys,
    /// an X11-style `0xFFxx` value otherwise, `0` when the key has no meaning
    /// on the current level), `mods` the modifier and lock bits in force after
    /// this event (`1` Shift, `2` Ctrl, `4` Alt, `8` Super, `0x10` AltGr,
    /// `0x20` CapsLock, `0x40` NumLock, `0x80` ScrollLock), `state` a
    /// `KeyState`, `ts_ns` the kernel timestamp and `seq` the raw sequence
    /// number. Auto-repeat is always flagged `Repeat`, never `Down`.
    method KeyEvent(code: U32, sym: U32, mods: U32, state: U32, ts_ns: U64, seq: U64) -> () = 10 oneway;
    /// Event: composed text (UTF-8) for a character-producing press or repeat.
    method TextInput(utf8: String) -> () = 11 oneway;
    /// Event: keyboard focus arrived. `down` lists the physical keys held right
    /// now, so the client seeds its key state.
    method KeyboardEnter(down: Array<U32>) -> () = 12 oneway;
    /// Event: keyboard focus left. The client **must release every key** it
    /// believes is down; `inputd` also cancels repeat.
    method KeyboardLeave() -> () = 13 oneway;
    /// Event: the layout changed (a `confd` write, live).
    method LayoutChanged(layout: String) -> () = 14 oneway;

    /// What happened to a key. Numeric values are the wire values.
    enum KeyState { Down, Up, Repeat }
}

/// The compositor side of `inputd`. Only the compositor may call it: `inputd`
/// accepts these calls solely from the task that holds the display grant (the
/// kernel says who that is), so no client can move focus or register a window on
/// someone else's behalf. Everything is per kernel-stamped sender, never per request field.
interface os.lazy.input.shell.v1 {
    /// Become the shell client; the parcel transfers the endpoint (`handles[0]`)
    /// that receives the shell events below. Attaching again replaces it.
    method Attach() -> () = 1;
    /// Move keyboard focus to `surface` (absent: nobody is focused and no key
    /// content is delivered). The previous holder gets `KeyboardLeave`, the new
    /// one `KeyboardEnter`; repeat is cancelled.
    method SetFocus(surface: Option<U64>) -> () = 2;
    /// Declare that `owner` (a task slot, as the compositor stamps in
    /// `Surface.owner`) created `surface`, so `inputd` can match that task's
    /// `Open` to the window.
    method RegisterSurface(surface: U64, owner: U64) -> () = 3;
    /// Forget a destroyed surface; its sessions are closed.
    method UnregisterSurface(surface: U64) -> () = 4;
    /// Register a chord: `code` (HID usage) with exactly the Shift/Ctrl/Alt/
    /// Super bits of `mods`. A match is consumed (its press and release are
    /// never delivered to a client) and reported as `HotkeyFired`.
    method RegisterHotkey(code: U32, mods: U32) -> (id: U64) = 5;
    /// Drop a chord.
    method UnregisterHotkey(id: U64) -> () = 6;
    /// Answer a `GrantRequested`. Keyboard grabs are not implemented yet, so
    /// this is refused with `ENOSYS`; the method is reserved so the interface
    /// does not change when they land.
    method ApproveGrant(session: U64, allow: Bool) -> () = 7;
    /// Shell event: a registered chord was pressed.
    method HotkeyFired(id: U64) -> () = 20 oneway;
    /// Shell event: a client asked for a grab (reserved; never sent yet).
    method GrantRequested(session: U64, kind: U32) -> () = 21 oneway;
    /// Shell event: the reserved escape chord was pressed (reserved).
    method EscapeChord() -> () = 22 oneway;
    /// Shell event: `surface` now receives keys through an input session, so
    /// the compositor must stop synthesising legacy `KeyDown`/`KeyUp` for it.
    method SessionOpened(surface: U64) -> () = 23 oneway;
    /// Shell event: the last input session of `surface` ended; legacy key
    /// delivery applies again.
    method SessionClosed(surface: U64) -> () = 24 oneway;
}

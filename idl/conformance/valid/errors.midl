// Conformance case: the standard reply error (docs/midl.md, "Errors").
// A failed call is answered with an `Error` field at the reserved reply field
// id instead of the declared reply fields; a reply field may use any other id.

interface os.lazy.conformance.errors.v1 {
    method Read(path: String = 1) -> (data: Bytes = 1, size: U64 = 16);
}

[
  {"wait_for": "SHELL:TRAY:SERVICE:PASS", "timeout": 300, "note": "run with tools/wifi/tray_run.py: image LAZYOS_DESKTOP=1 LAZYOS_NETD=1 LAZYOS_NETD_ARGS=demo=0 LAZYOS_WIFI=1 LAZYOS_WIFI_SIM=1 LAZYOS_UI_PROBE=1 LAZYOS_XUI_AUTOSTART=term LAZYOS_RESET_OS=1, the fake access points (tools/wifi/fake_ap.py) on the guest's air card; Settings offsets are from the window centre (the dark theme)"},
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 420},
  {"wait_for": "TERM:UP:PASS", "timeout": 300},
  {"wait_for": "NETSTATUS:WIFI:UP wlan0", "timeout": 300},
  {"wait_for": "NETSTATUS:ICON disconnected", "timeout": 180},
  {"wait_for": "UI:RECT .*name=tray:os.lazy.netstatus", "regex": true, "timeout": 60},
  {"wait": 2.0},
  {"move_to": {"target": "tray:os.lazy.netstatus"}},
  {"wait_for": "SHELL:TRAY:TOOLTIP app=os.lazy.netstatus", "timeout": 30},
  {"wait": 1.0},
  {"shot": "01_disconnected_tooltip"},
  {"click_at": {"target": "tray:os.lazy.netstatus"}, "until": "SHELL:TRAY:MENU:OPEN app=os.lazy.netstatus", "timeout": 30, "retries": 2, "note": "a click opens the menu of the fake networks"},
  {"wait": 1.0},
  {"shot": "02_menu_networks"},
  {"click_at": {"target": "traymenu:LazyOpen  (open, 4 of 4 bars)"}, "until": "NETSTATUS:WIFI:ACTION join-open ssid=LazyOpen", "timeout": 30, "retries": 1, "note": "an open network that is not saved: saved and joined"},
  {"wait_for": "NETSTATUS:STATE Wi-Fi: connected to LazyOpen", "timeout": 180},
  {"wait": 2.0},
  {"move_to": {"target": "tray:os.lazy.netstatus"}},
  {"wait": 0.5},
  {"shot": "03_connected_tooltip"},
  {"click_at": {"target": "tray:os.lazy.netstatus"}, "until": "SHELL:TRAY:MENU:OPEN app=os.lazy.netstatus", "timeout": 30, "retries": 2},
  {"wait": 1.0},
  {"shot": "04_menu_connected"},
  {"click_at": {"target": "traymenu:Disconnect"}, "until": "NETSTATUS:WIFI:ACTION disconnect", "timeout": 30, "retries": 1},
  {"wait_for": "NETSTATUS:WIFI:DISCONNECT:PASS", "timeout": 30},
  {"wait": 3.0},
  {"move_to": {"target": "tray:os.lazy.netstatus"}},
  {"wait": 0.5},
  {"shot": "05_disconnected_again"},
  {"click_at": {"target": "taskbar:start"}, "until": "SHELL:MENU:OPEN", "timeout": 30, "retries": 2},
  {"wait": 1.0},
  {"click_at": {"menu": "System"}, "until": "SHELL:SUBMENU:OPEN category=system", "timeout": 30, "retries": 1},
  {"wait": 1.0},
  {"click_at": {"menu": "Settings"}, "until": "SETTINGS:UP:PASS", "timeout": 60, "retries": 1},
  {"wait_for": "UI:RECT .*name=window:Settings", "regex": true, "timeout": 60},
  {"wait": 2.0},
  {"click_at": {"window": "Settings", "offset": [-267, 185]}, "until": "SETTINGS:MSG:Section\\(8\\)", "regex": true, "timeout": 30, "retries": 1, "note": "the Wi-Fi page"},
  {"wait": 1.5},
  {"click_at": {"window": "Settings", "offset": [26, -62]}, "note": "the search field"},
  {"wait": 0.5},
  {"type": "fran"},
  {"wait_for": "SETTINGS:MSG:Wifi\\(Filter\\(\"fran\"\\)\\)", "regex": true, "timeout": 30},
  {"wait": 1.0},
  {"shot": "06_settings_wifi_searched"},
  {"click_at": {"window": "Settings", "offset": [-89, 147]}, "until": "XUID:PROMPT:UP", "timeout": 40, "retries": 1, "note": "Use this country: one request, asks an administrator"},
  {"wait": 1.5},
  {"shot": "07_prompt_country"},
  {"type": "admin"},
  {"key": "tab"},
  {"type": "nimda"},
  {"key": "ret", "until": "SETTINGS:WIFI:COUNTRY:FR", "timeout": 120},
  {"wait_for": "ELEVD:REQUEST op=net.wifi.country .*admin=admin outcome=granted summary=\"Set the Wi-Fi country to France", "regex": true, "timeout": 60},
  {"wait_for": "WLANMD:RADIO:COUNTRY:SET wlan0 FR", "timeout": 60, "note": "wlanmd re-reads the key within 10 s and gives it to the radio"},
  {"wait": 1.5},
  {"shot": "08_country_set"},
  {"click_at": {"target": "tray:os.lazy.netstatus"}, "until": "SHELL:TRAY:MENU:OPEN app=os.lazy.netstatus", "timeout": 30, "retries": 2},
  {"wait": 1.0},
  {"click_at": {"target": "traymenu:LazyWPA2  (locked, 4 of 4 bars)"}, "until": "NETSTATUS:WIFI:ACTION configure", "timeout": 30, "retries": 1, "note": "a secured network that is not saved: the Network app opens (the tray never asks for a passphrase)"},
  {"wait_for": "INIT:LAUNCH:PASS app=os.lazy.network", "timeout": 60},
  {"wait": 4.0},
  {"shot": "09_network_app_opened"},
  {"wait": 6.0, "note": "past the 5 s flusher"},
  {"quit": true}
]

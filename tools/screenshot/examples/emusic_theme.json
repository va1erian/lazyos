[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 600},
  {"wait_for": "TERM:UP:PASS", "timeout": 300},
  {"wait_for": "PKGD:UP:PASS", "timeout": 120},
  {"wait_for": "PKGD:RECONCILE:PASS", "timeout": 120},
  {"at": 2.0, "click_at": {"window": "Terminal"}, "note": "focus the Terminal"},
  {"at": 0.4, "type": "PS1='#"},
  {"at": 0.4, "type": " '"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:PS1='# '", "timeout": 30, "retries": 2},
  {"at": 0.4, "type": "cp /sy"},
  {"at": 0.4, "type": "stem/s"},
  {"at": 0.4, "type": "hare/s"},
  {"at": 0.4, "type": "amples"},
  {"at": 0.4, "type": "/emusi"},
  {"at": 0.4, "type": "c.lzp "},
  {"at": 0.4, "type": "~/ && "},
  {"at": 0.4, "type": "echo s"},
  {"at": 0.4, "type": "taged"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:cp /system/share/samples/emusic.lzp ~/ && echo staged", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:staged", "timeout": 120},
  {"at": 0.4, "type": "pkgctl"},
  {"at": 0.4, "type": " insta"},
  {"at": 0.4, "type": "ll ~/e"},
  {"at": 0.4, "type": "music."},
  {"at": 0.4, "type": "lzp"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:pkgctl install ~/emusic.lzp", "timeout": 30, "retries": 2},
  {"wait_for": "PKGD:INSTALL:PASS org.lazy.emusic", "timeout": 900},
  {"wait_for": "TERM:OUT:PKGCTL:INSTALL:PASS", "timeout": 60},
  {"at": 0.4, "type": "cd /ap"},
  {"at": 0.4, "type": "ps/org"},
  {"at": 0.4, "type": ".lazy."},
  {"at": 0.4, "type": "emusic"},
  {"at": 0.4, "type": "/*/res"},
  {"at": 0.4, "type": "ources"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:cd /apps/org.lazy.emusic/*/resources", "timeout": 30, "retries": 2},
  {"at": 0.4, "type": "mkdir "},
  {"at": 0.4, "type": "~/Musi"},
  {"at": 0.4, "type": "c; cp "},
  {"at": 0.4, "type": "tones."},
  {"at": 0.4, "type": "mp3 ~/"},
  {"at": 0.4, "type": "Music/"},
  {"at": 0.4, "type": " && cd"},
  {"at": 0.4, "type": " && ec"},
  {"at": 0.4, "type": "ho cop"},
  {"at": 0.4, "type": "ied"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:mkdir ~/Music; cp tones.mp3 ~/Music/ && cd && echo copied", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:copied", "timeout": 120},
  {"at": 0.5, "shot": "01_installed"},
  {"at": 0.4, "type": "confct"},
  {"at": 0.4, "type": "l set "},
  {"at": 0.4, "type": "user/1"},
  {"at": 0.4, "type": "000/ui"},
  {"at": 0.4, "type": "/mode "},
  {"at": 0.4, "type": "str da"},
  {"at": 0.4, "type": "rk"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:confctl set user/1000/ui/mode str dark", "timeout": 30, "retries": 2},
  {"at": 0.4, "type": "(while"},
  {"at": 0.4, "type": " ! tes"},
  {"at": 0.4, "type": "t -f /"},
  {"at": 0.4, "type": "tmp/go"},
  {"at": 0.4, "type": ";do sl"},
  {"at": 0.4, "type": "eep 1;"},
  {"at": 0.4, "type": "done;c"},
  {"at": 0.4, "type": "onfctl"},
  {"at": 0.4, "type": " set u"},
  {"at": 0.4, "type": "ser/10"},
  {"at": 0.4, "type": "00/ui/"},
  {"at": 0.4, "type": "mode s"},
  {"at": 0.4, "type": "tr lig"},
  {"at": 0.4, "type": "ht)&"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:(while ! test -f /tmp/go;do sleep 1;done;confctl set user/1000/ui/mode str light)&", "timeout": 30, "retries": 2},
  {"at": 0.4, "type": "rhai -"},
  {"at": 0.4, "type": "e 'sys"},
  {"at": 0.4, "type": "::mime"},
  {"at": 0.4, "type": "d::ope"},
  {"at": 0.4, "type": "n(\"/ho"},
  {"at": 0.4, "type": "me/use"},
  {"at": 0.4, "type": "r/Musi"},
  {"at": 0.4, "type": "c/tone"},
  {"at": 0.4, "type": "s.mp3\""},
  {"at": 0.4, "type": ",\"open"},
  {"at": 0.4, "type": "\")'"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:rhai -e 'sys::mimed::open(\"/home/user/Music/tones.mp3\",\"open\")'", "timeout": 30, "retries": 2},
  {"wait_for": "EMUSIC:UP:PASS", "timeout": 300},
  {"wait_for": "EMUSIC:PLAY:tones.mp3", "timeout": 120},
  {"at": 1.0, "shot": "02_dark_follows_desktop"},
  {"mouse_move": [-300, -300]},
  {"mouse_move": [-300, -300]},
  {"mouse_move": [-300, -300]},
  {"mouse_move": [-300, -300]},
  {"mouse_move": [80, 400]},
  {"wait": 0.3},
  {"mouse_click": "left", "note": "focus the Terminal's visible strip"},
  {"at": 0.4, "type": "touch "},
  {"at": 0.4, "type": "/tmp/g"},
  {"at": 0.4, "type": "o"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:touch /tmp/go", "timeout": 30, "retries": 2},
  {"mouse_move": [820, -345], "note": "raise emusic again (its title bar)"},
  {"wait": 0.3},
  {"mouse_click": "left"},
  {"wait_for": "THEME:APPLIED", "timeout": 120},
  {"at": 3.0, "shot": "03_light_follows_desktop"},
  {"at": 1.5, "quit": true}
]

[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 600},
  {"wait_for": "TERM:UP:PASS", "timeout": 300},
  {"wait_for": "PKGD:RECONCILE:PASS", "timeout": 120},
  {"at": 2.0, "click_at": {"window": "Terminal"}, "note": "focus the Terminal"},
  {"wait": 1.5},
  {"at": 0.4, "type": "PS1='#"},
  {"at": 0.4, "type": " '"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:PS1='# '", "timeout": 30, "retries": 2},
  {"at": 0.4, "type": "cd && "},
  {"at": 0.4, "type": "cp /sy"},
  {"at": 0.4, "type": "stem/s"},
  {"at": 0.4, "type": "hare/w"},
  {"at": 0.4, "type": "allpap"},
  {"at": 0.4, "type": "ers/[A"},
  {"at": 0.4, "type": "D]* . "},
  {"at": 0.4, "type": "&& ech"},
  {"at": 0.4, "type": "o copi"},
  {"at": 0.4, "type": "ed"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:cd && cp /system/share/wallpapers/[AD]* . && echo copied", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:copied", "timeout": 60},
  {"at": 0.4, "type": "rhai -"},
  {"at": 0.4, "type": "e 'sys"},
  {"at": 0.4, "type": "::mime"},
  {"at": 0.4, "type": "d::ope"},
  {"at": 0.4, "type": "n(\"/ho"},
  {"at": 0.4, "type": "me/use"},
  {"at": 0.4, "type": "r/Auro"},
  {"at": 0.4, "type": "ra.jpg"},
  {"at": 0.4, "type": "\",\"ope"},
  {"at": 0.4, "type": "n\")'"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:rhai -e 'sys::mimed::open(\"/home/user/Aurora.jpg\",\"open\")'", "timeout": 30, "retries": 2},
  {"wait_for": "LRPLAY:DOCUMENT:PASS:/home/user/Aurora.jpg", "timeout": 120, "note": "mimed maps .jpg to the viewer; init passes the picture"},
  {"wait_for": "LRPLAY:UP:PASS", "timeout": 180},
  {"wait_for": "UI:WIDGET", "timeout": 30},
  {"wait": 3.0},
  {"shot": "01_opened"},
  {"click_at": {"window": "Picture Viewer", "widget": "picture1"}, "note": "focus the picture (a click without a drag)"},
  {"wait": 1.5},
  {"key": "right", "until": "LRPLAY:EVENT:PASS", "timeout": 30, "retries": 1, "note": "next picture in the folder: Dunes.jpg"},
  {"wait": 4.0},
  {"shot": "02_next"},
  {"key": "k", "note": "rotate right"},
  {"wait": 4.0},
  {"shot": "03_rotated"},
  {"click_at": {"window": "Picture Viewer", "widget": "rotate_ccw_button"}, "note": "back upright"},
  {"wait": 3.0},
  {"click_at": {"window": "Picture Viewer", "widget": "zoom_in_button"}},
  {"wait": 3.0},
  {"click_at": {"window": "Picture Viewer", "widget": "zoom_in_button"}},
  {"wait": 4.0},
  {"shot": "04_zoomed"},
  {"click_at": {"window": "Picture Viewer", "widget": "slideshow_button"}, "note": "a new picture every four seconds"},
  {"wait": 10.0},
  {"shot": "05_slide_show"},
  {"key": "escape", "note": "stop the slide show"},
  {"wait": 4.0},
  {"shot": "06_stopped"},
  {"quit": true}
]

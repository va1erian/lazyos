[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 600},
  {"wait_for": "TERM:UP:PASS", "timeout": 300},
  {"wait_for": "PKGD:UP:PASS", "timeout": 120},
  {"wait_for": "PKGD:RECONCILE:PASS", "timeout": 120},
  {"at": 2.0, "click_at": {"window": "Terminal"}, "note": "focus the Terminal"},
  {"at": 4.6, "shot": "01_terminal"},
  {"at": 0.4, "type": "PS1='#"},
  {"at": 0.4, "type": " '"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:PS1='# '", "timeout": 30, "retries": 2},
  {"at": 0.4, "type": "cp /sy"},
  {"at": 0.4, "type": "stem/s"},
  {"at": 0.4, "type": "hare/s"},
  {"at": 0.4, "type": "amples"},
  {"at": 0.4, "type": "/srb2k"},
  {"at": 0.4, "type": "art.lz"},
  {"at": 0.4, "type": "p ~/ &"},
  {"at": 0.4, "type": "& echo"},
  {"at": 0.4, "type": " stage"},
  {"at": 0.4, "type": "d"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:cp /system/share/samples/srb2kart.lzp ~/ && echo staged", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:staged", "timeout": 120},
  {"at": 0.4, "type": "pkgctl"},
  {"at": 0.4, "type": " insta"},
  {"at": 0.4, "type": "ll ~/s"},
  {"at": 0.4, "type": "rb2kar"},
  {"at": 0.4, "type": "t.lzp"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:pkgctl install ~/srb2kart.lzp", "timeout": 30, "retries": 2},
  {"wait_for": "PKGD:INSTALL:PASS org.lazy.srb2kart", "timeout": 900},
  {"wait_for": "TERM:OUT:PKGCTL:INSTALL:PASS", "timeout": 60},
  {"at": 1.0, "shot": "02_installed"},
  {"at": 0.4, "type": "cd /ap"},
  {"at": 0.4, "type": "ps/org"},
  {"at": 0.4, "type": ".lazy."},
  {"at": 0.4, "type": "srb2ka"},
  {"at": 0.4, "type": "rt/*/b"},
  {"at": 0.4, "type": "in"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:cd /apps/org.lazy.srb2kart/*/bin", "timeout": 30, "retries": 2},
  {"at": 0.4, "type": "./srb2"},
  {"at": 0.4, "type": "kart.e"},
  {"at": 0.4, "type": "lf -he"},
  {"at": 0.4, "type": "adless"},
  {"at": 0.4, "type": " -fram"},
  {"at": 0.4, "type": "es 300"},
  {"at": 0.4, "type": " >/dev"},
  {"at": 0.4, "type": "/null;"},
  {"at": 0.4, "type": "cat /t"},
  {"at": 0.4, "type": "mp/srb"},
  {"at": 0.4, "type": "2kart-"},
  {"at": 0.4, "type": "result"},
  {"at": 0.4, "type": ".txt"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:./srb2kart.elf -headless -frames 300 >/dev/null;cat /tmp/srb2kart-result.txt", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:SRB2KART:HEADLESS:PASS", "timeout": 1200},
  {"at": 1.0, "shot": "03_headless"},
  {"at": 1.0, "click_at": {"target": "taskbar:start"}, "until": "SHELL:MENU:OPEN", "timeout": 30, "retries": 2},
  {"at": 1.0, "move_to": {"menu": "Games"}, "until": "SHELL:SUBMENU:OPEN category=games", "timeout": 30, "retries": 1},
  {"at": 1.0, "move_to": {"menu": "SRB2Kart"}},
  {"at": 2.5, "shot": "04_menu_with_srb2kart"},
  {"at": 3.0, "click_at": {"menu": "SRB2Kart"}, "until": "SHELL:LAUNCH:PASS app=org.lazy.srb2kart", "timeout": 60, "retries": 1},
  {"wait_for": "PKGD:LAUNCH:LABEL app:org.lazy.srb2kart", "timeout": 60},
  {"wait_for": "SRB2KART:UP:PASS mode=window", "timeout": 600},
  {"at": 0.5, "move_to": {"window": "SRB2Kart"}, "timeout": 30, "note": "the pointer rests on the game"},
  {"wait_for": "SRB2KART:LOG: GAMESTATE:title", "timeout": 1500, "note": "the data takes a while to load, then the intro plays"},
  {"wait": 12.0, "note": "let the title settle"},
  {"shot": "05_title"},
  {"key": "enter"},
  {"wait": 3.0},
  {"shot": "06_menu"},
  {"key": "enter", "note": "Time Attack"},
  {"wait": 2.0},
  {"key": "enter"},
  {"wait": 2.0},
  {"shot": "07_menus"},
  {"key": "enter"},
  {"wait": 2.0},
  {"key": "enter"},
  {"wait": 2.0},
  {"key": "enter"},
  {"wait_for": "SRB2KART:LOG: GAMESTATE:level", "timeout": 600},
  {"wait": 20.0, "note": "past the starting countdown"},
  {"shot": "08_race_start"},
  {"key_down": "a", "note": "accelerate"},
  {"wait": 6.0},
  {"shot": "09_driving"},
  {"key_down": "left"},
  {"wait": 1.5},
  {"key_up": "left"},
  {"wait": 3.0},
  {"shot": "10_turned"},
  {"key_up": "a"},
  {"wait": 1.0},
  {"click_at": [1269, 59], "note": "the window's close button: the engine quits cleanly"},
  {"wait_for": "SRB2KART:QUIT:PASS", "timeout": 120},
  {"wait": 2.0},
  {"shot": "11_closed"},
  {"quit": true}
]

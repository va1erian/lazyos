[
  {"wait_for": "TERM:UP:PASS", "timeout": 300},
  {"wait_for": "xuid: pointer from inputd", "timeout": 300},
  {"wait_for": "XUIAPP:COUNTER:PASS", "timeout": 300},
  {"at": 3.0, "mouse_move": [-1500, -1500]},
  {"at": 4.0, "mouse_move": [44, 704], "note": "taskbar: Start"},
  {"at": 5.0, "mouse_click": "left", "until": "SHELL:MENU:OPEN", "timeout": 30, "retries": 2},
  {"at": 1.0, "mouse_move": [90, -128], "note": "start menu: the System row (134,576)"},
  {"wait_for": "SHELL:SUBMENU:OPEN category=system", "timeout": 30},
  {"mouse_move": [204, 72], "note": "System submenu: Terminal (338,648)"},
  {"at": 0.5, "mouse_click": "left", "until": "SHELL:LAUNCH:PASS app=terminal", "timeout": 30, "retries": 1},
  {"wait_for": "TERM:UP:PASS", "occurrence": 2, "timeout": 120, "note": "the new Terminal has the focus"},
  {"wait_for": "init: started inputd \\(pid (\\d+)", "regex": true, "capture": "inputd_pid", "timeout": 240},
  {"at": 7.0, "type": "kill -9 ${inputd_pid}"},
  {"at": 3.0, "key": "enter", "until": "xuid: pointer back on the kernel stream", "timeout": 60, "retries": 1},
  {"wait_for": "init: started inputd (pid", "timeout": 120},
  {"wait_for": "xuid: pointer from inputd", "timeout": 120},
  {"at": 3.0, "shot": "01_after_restart"},
  {"at": 4.0, "mouse_move": [-1500, -1500]},
  {"at": 5.0, "mouse_move": [336, 704]},
  {"at": 6.0, "mouse_click": "left"},
  {"at": 8.0, "shot": "02_taskbar_click_after_restart"},
  {"at": 9.0, "quit": true}
]

  {"wait_for": "SHELL:TRAY:CLEAR app=os.lazy.traydemo why=(gone|stopped)", "regex": true, "timeout": 30, "note": "the item goes once the app is gone"},
  {"wait_for": "INIT:STOP:PASS app=os.lazy.traydemo stopped=1", "timeout": 30},
  {"wait_for": "mem: reaped task ${demo_pid}:", "timeout": 30},
  {"wait_for": "SHELL:TRAY:QUIT app=os.lazy.traydemo stopped=1", "timeout": 30},

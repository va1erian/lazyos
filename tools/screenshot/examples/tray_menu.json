  {"wait_for": "SHELL:TRAY:SET app=os.lazy.traydemo", "timeout": 120},
  {"wait": 1.5},
  {"click_at": {"target": "tray:os.lazy.traydemo"}, "button": "right", "until": "SHELL:TRAY:MENU:OPEN app=os.lazy.traydemo", "timeout": 30, "retries": 2},
  {"wait": 1.0},
  {"shot": "01_menu_dark"},
  {"click_at": {"target": "traymenu:Notifications"}, "until": "TRAYDEMO:MENU:2:true", "timeout": 30, "retries": 1},
  {"wait_for": "SHELL:TRAY:MENU:CLOSE", "timeout": 30},
  {"wait_for": "SHELL:TRAY:UPDATE app=os.lazy.traydemo", "timeout": 30},
  {"wait": 0.5},
  {"click_at": {"target": "tray:os.lazy.traydemo"}, "button": "right", "until": "SHELL:TRAY:MENU:OPEN app=os.lazy.traydemo", "timeout": 30, "retries": 2},
  {"wait": 0.8},
  {"click_at": {"target": "traymenu:Icon"}, "until": "name=traymenu:Pixels", "timeout": 30, "retries": 1},
  {"wait": 1.0},
  {"shot": "02_submenu_dark"},
  {"click_at": {"target": "traymenu:Pixels"}, "until": "TRAYDEMO:MENU:6:true", "timeout": 30, "retries": 1},
  {"wait_for": "SHELL:TRAY:ICON app=os.lazy.traydemo source=pixels", "timeout": 30},
  {"key_down": "alt", "note": "Alt+Tab to the Terminal"},
  {"wait": 0.2},
  {"key": "tab"},
  {"wait": 0.3},
  {"key_up": "alt"},
  {"wait": 0.8},
  {"type": "confctl set sys/ui/mode str light"},
  {"wait": 0.5},
  {"key": "enter", "until": "TERM:CMD:confctl set sys/ui/mode str light", "timeout": 30, "retries": 2},

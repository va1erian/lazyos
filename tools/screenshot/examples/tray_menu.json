[
  {"wait_for": "SHELL:TRAY:SERVICE:PASS", "timeout": 240, "note": "image: LAZYOS_DESKTOP=1 LAZYOS_TRAYDEMO=1 LAZYOS_UI_PROBE=1 LAZYOS_XUI_AUTOSTART=term"},
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 420},

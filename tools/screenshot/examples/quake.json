[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 600},
  {"wait_for": "TERM:UP:PASS", "timeout": 300},
  {"wait_for": "PKGD:UP:PASS", "timeout": 120},
  {"wait_for": "PKGD:RECONCILE:PASS", "timeout": 120},
  {"at": 2.0, "click_at": {"window": "Terminal"}, "note": "focus the Terminal"},
  {"at": 4.6, "shot": "01_terminal"},
  {"at": 0.4, "type": "PS1='#"},
  {"at": 0.4, "type": " '"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:PS1='# '", "timeout": 30, "retries": 2},
  {"at": 0.4, "type": "cp /sy"},
  {"at": 0.4, "type": "stem/s"},
  {"at": 0.4, "type": "hare/s"},
  {"at": 0.4, "type": "amples"},
  {"at": 0.4, "type": "/quake"},
  {"at": 0.4, "type": ".lzp ~/"},
  {"at": 0.4, "type": " && ec"},
  {"at": 0.4, "type": "ho sta"},
  {"at": 0.4, "type": "ged"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:cp /system/share/samples/quake.lzp ~/ && echo staged", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:staged", "timeout": 240},
  {"at": 0.4, "type": "pkgctl"},
  {"at": 0.4, "type": " insta"},
  {"at": 0.4, "type": "ll ~/q"},
  {"at": 0.4, "type": "uake.l"},
  {"at": 0.4, "type": "zp"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:pkgctl install ~/quake.lzp", "timeout": 30, "retries": 2},
  {"wait_for": "PKGD:INSTALL:PASS org.lazy.quake", "timeout": 900},
  {"wait_for": "TERM:OUT:PKGCTL:INSTALL:PASS", "timeout": 60},
  {"at": 1.0, "shot": "02_installed"},
  {"at": 0.4, "type": "pkgctl"},
  {"at": 0.4, "type": " list|"},
  {"at": 0.4, "type": "grep -"},
  {"at": 0.4, "type": "q 'qua"},
  {"at": 0.4, "type": "ke.* u"},
  {"at": 0.4, "type": "ser$'&&"},
  {"at": 0.4, "type": "echo Q"},
  {"at": 0.4, "type": "UAKE:US"},
  {"at": 0.4, "type": "ER"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:pkgctl list|grep -q 'quake.* user$'&&echo QUAKE:USER", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:QUAKE:USER", "timeout": 60},
  {"at": 0.4, "type": "cd /ap"},
  {"at": 0.4, "type": "ps/org"},
  {"at": 0.4, "type": ".lazy."},
  {"at": 0.4, "type": "quake/"},
  {"at": 0.4, "type": "*/bin"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:cd /apps/org.lazy.quake/*/bin", "timeout": 30, "retries": 2},
  {"at": 0.4, "type": "./quak"},
  {"at": 0.4, "type": "e.elf -"},
  {"at": 0.4, "type": "headle"},
  {"at": 0.4, "type": "ss -fr"},
  {"at": 0.4, "type": "ames 2"},
  {"at": 0.4, "type": "00 >/de"},
  {"at": 0.4, "type": "v/null"},
  {"at": 0.4, "type": ";cat /t"},
  {"at": 0.4, "type": "mp/quak"},
  {"at": 0.4, "type": "e-resul"},
  {"at": 0.4, "type": "t.txt"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:./quake.elf -headless -frames 200 >/dev/null;cat /tmp/quake-result.txt", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:QUAKE:HEADLESS:PASS", "timeout": 900},
  {"at": 1.0, "shot": "03_headless"},
  {"at": 1.0, "click_at": {"target": "taskbar:start"}, "until": "SHELL:MENU:OPEN", "timeout": 30, "retries": 2},
  {"at": 1.0, "move_to": {"menu": "Games"}, "until": "SHELL:SUBMENU:OPEN category=games", "timeout": 30, "retries": 1},
  {"at": 1.0, "move_to": {"menu": "Quake"}},
  {"at": 2.5, "shot": "04_menu_with_quake"},
  {"at": 3.0, "click_at": {"menu": "Quake"}, "until": "SHELL:LAUNCH:PASS app=org.lazy.quake", "timeout": 60, "retries": 1},
  {"wait_for": "PKGD:LAUNCH:LABEL app:org.lazy.quake", "timeout": 60},
  {"wait_for": "QUAKE:UP:PASS mode=window", "timeout": 300},
  {"at": 0.5, "move_to": {"window": "Quake"}, "timeout": 30, "note": "the pointer rests on the game"},
  {"at": 10.0, "shot": "05_title"},
  {"at": 11.0, "key": "esc"},
  {"at": 12.5, "shot": "06_menu"},
  {"at": 13.5, "key": "enter"},
  {"at": 14.5, "key": "enter"},
  {"at": 15.5, "key": "enter"},
  {"at": 19.5, "shot": "07_e1m1"},
  {"at": 20.0, "key_down": "up"},
  {"at": 21.5, "key_up": "up"},
  {"at": 21.8, "key_down": "ctrl"},
  {"at": 22.2, "shot": "08_firing"},
  {"at": 22.6, "key_up": "ctrl"},
  {"at": 23.1, "key_down": "left"},
  {"at": 23.9, "key_up": "left"},
  {"at": 24.9, "shot": "09_turned"},
  {"at": 25.9, "quit": true}
]

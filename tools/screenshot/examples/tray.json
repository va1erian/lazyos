[
  {"wait_for": "INIT:LAUNCH:PASS app=lazyshell pid=(\\d+)", "regex": true, "capture": "shell_pid", "timeout": 240, "note": "image: LAZYOS_DESKTOP=1 LAZYOS_TRAYDEMO=1 LAZYOS_UI_PROBE=1 LAZYOS_XUI_AUTOSTART=term"},
  {"wait_for": "SHELL:TRAY:SERVICE:PASS", "timeout": 240},
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 420},
  {"wait_for": "TERM:UP:PASS", "timeout": 240},
  {"wait": 1.0},
  {"click_at": {"target": "taskbar:start"}, "until": "SHELL:MENU:OPEN", "timeout": 30, "retries": 2},
  {"wait": 1.5},
  {"move_to": {"menu": "Development"}, "until": "SHELL:SUBMENU:OPEN category=development", "timeout": 30, "retries": 1},
  {"wait": 0.4},
  {"click_at": {"menu": "Tray Demo"}, "until": "INIT:LAUNCH:PASS app=os.lazy.traydemo", "timeout": 60, "retries": 1},
  {"wait_for": "INIT:LAUNCH:PASS app=os.lazy.traydemo pid=(\\d+)", "regex": true, "capture": "demo_pid", "timeout": 60},
  {"wait_for": "TRAYDEMO:UP:PASS", "timeout": 240},
  {"wait_for": "SHELL:TRAY:SET app=os.lazy.traydemo", "timeout": 120},
  {"wait_for": "SHELL:TRAY:ICON app=os.lazy.traydemo source=lucide:zap", "timeout": 60},
  {"wait": 2.0},
  {"shot": "01_lucide_icon"},
  {"click_at": {"target": "tray:os.lazy.traydemo"}, "until": "TRAYDEMO:ACTIVATE:PASS n=1", "timeout": 30, "retries": 2},
  {"wait_for": "SHELL:TRAY:UPDATE app=os.lazy.traydemo", "timeout": 30},
  {"wait_for": "SHELL:TRAY:TOOLTIP app=os.lazy.traydemo", "timeout": 30},
  {"wait": 1.0},
  {"shot": "02_activated_badge_tooltip"},
  {"click_at": {"target": "tray:os.lazy.traydemo"}, "button": "right", "until": "SHELL:TRAY:MENU:OPEN app=os.lazy.traydemo", "timeout": 30, "retries": 2, "note": "an item with a menu opens it (stage T2); one without gets SecondaryActivate"},
  {"mouse_scroll": 1, "until": "TRAYDEMO:SCROLL:", "timeout": 30, "retries": 2},
  {"click_at": {"window": "Tray Demo"}, "note": "focus the demo window"},
  {"wait": 0.5},
  {"key": "p", "until": "TRAYDEMO:ICON:pixels", "timeout": 30, "retries": 2},
  {"wait_for": "SHELL:TRAY:ICON app=os.lazy.traydemo source=pixels", "timeout": 30},
  {"wait": 1.0},
  {"shot": "03_pixels_icon"},
  {"key": "b", "until": "TRAYDEMO:ICON:bad", "timeout": 30, "retries": 2},
  {"wait_for": "SHELL:TRAY:ICON app=os.lazy.traydemo source=file:app-16.png", "timeout": 30},
  {"wait": 1.0},
  {"shot": "04_bad_icon_package_fallback"},
  {"key": "l", "until": "TRAYDEMO:ICON:lucide", "timeout": 30, "retries": 2},
  {"wait_for": "SHELL:TRAY:ICON app=os.lazy.traydemo source=lucide:zap", "occurrence": 2, "timeout": 30},
  {"key": "a", "until": "TRAYDEMO:ATTENTION:true", "timeout": 30, "retries": 2},
  {"wait": 1.2},
  {"shot": "04b_attention_a"},
  {"wait": 0.5},
  {"shot": "04c_attention_b"},
  {"key": "a", "until": "TRAYDEMO:ATTENTION:false", "timeout": 30, "retries": 2},
  {"key_down": "alt", "note": "Alt+Tab back to the Terminal (the demo window may cover its centre)"},
  {"wait": 0.2},
  {"key": "tab"},
  {"wait": 0.3},
  {"key_up": "alt"},
  {"wait": 0.8},
  {"type": "kill -9 ${shell_pid}"},
  {"wait": 0.6},
  {"key": "enter", "until": "TERM:CMD:kill -9 ", "timeout": 30, "retries": 2},
  {"wait_for": "INIT:RESTART:PASS name=lazyshell", "timeout": 60},
  {"wait_for": "SHELL:TRAY:GENERATION n=\\d+ restart=true", "regex": true, "timeout": 120},
  {"wait_for": "SHELL:TRAY:RESTORED n=1", "timeout": 60},
  {"wait": 2.0},
  {"shot": "05_shell_restarted_icon_restored"},
  {"wait": 0.8, "note": "the Terminal kept the focus through the shell restart"},
  {"type": "kill -9 ${demo_pid}"},
  {"wait": 0.6},
  {"key": "enter", "until": "INIT:LAUNCH:EXIT app=os.lazy.traydemo", "timeout": 30, "retries": 1},
  {"wait_for": "SHELL:TRAY:CLEAR app=os.lazy.traydemo why=gone", "timeout": 5},
  {"wait": 1.0},
  {"shot": "06_app_killed_icon_gone"},
  {"quit": true}
]

[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 600},
  {"wait_for": "TERM:UP:PASS", "timeout": 300},
  {"wait_for": "NETD:RESOLV wrote", "timeout": 300},
  {"at": 2.0, "type": "wget -q -O /tmp/w.sh http://10.0.2.2/lazyweb-check.sh?precheck; sh /tmp/w.sh >/dev/console 2>&1", "delay": 0.05},
  {"key": "enter", "until": "WEBH:started", "timeout": 300.0},
  {"wait_for": "WEBH:hosts:", "timeout": 300.0},
  {"wait_for": "WEBH:http:", "timeout": 300.0},
  {"wait_for": "WEBH:https:", "timeout": 300.0},
  {"wait_for": "WEBH:redirect:", "timeout": 300.0},
  {"wait_for": "WEBH:www:", "timeout": 300.0},
  {"wait_for": "WEBH:png:", "timeout": 300.0},
  {"wait_for": "WEBH:jpeg:", "timeout": 300.0},
  {"wait_for": "WEBH:gif:", "timeout": 300.0},
  {"wait_for": "WEBH:done", "timeout": 300.0},
  {"at": 1.0, "type": "P=$(echo /apps/os.lazy.lazyweb/*/bin/lazyweb.elf)", "delay": 0.05, "phase": "app"},
  {"key": "enter", "until": "TERM:CMD:P=$(echo /apps/os.lazy.lazyweb/*/bin/lazyweb.elf)", "timeout": 30, "retries": 2},
  {"at": 1.0, "type": "$P --client http://example.com/ >/dev/console 2>&1 &", "delay": 0.05},
  {"key": "enter", "until": "WEB:UP:PASS", "timeout": 300.0},
  {"wait_for": "WEB:LOAD:http://example.com/", "timeout": 300.0},
  {"wait_for": "WEB:TITLE:Example Domain", "timeout": 300.0},
  {"at": 5.0, "shot": "01_example"},
  {"key_down": "ctrl"},
  {"key": "l"},
  {"key_up": "ctrl"},
  {"wait": 1.0},
  {"type": "https://theoldnet.com/", "delay": 0.05},
  {"key": "enter", "until": "WEB:LOAD:https://theoldnet.com/", "timeout": 300.0},
  {"wait_for": "WEB:TITLE:TheOldNet.com - Surf the Old Web", "timeout": 300.0},
  {"at": 10.0, "shot": "02_theoldnet"},
  {"at": 2.0, "shot": "03_theoldnet_later"},
  {"at": 1.0, "quit": true}
]

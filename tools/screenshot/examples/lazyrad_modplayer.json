[
 {
  "wait_for": "TERM:UP:PASS",
  "timeout": 240
 },
 {
  "wait": 2
 },
 {
  "type": "PS1='# '"
 },
 {
  "key": "enter",
  "until": "TERM:CMD:PS1='# '",
  "timeout": 30,
  "retries": 1
 },
 {
  "wait": 0.5
 },
 {
  "wait_for": "PKGD:PROVISION:DONE",
  "timeout": 420
 },
 {
  "type": "P=$(echo /apps/os.lazy.lazyrad/*/bin/lrplay.elf)"
 },
 {
  "key": "enter",
  "until": "TERM:CMD:P=$(echo /apps/os.lazy.lazyrad/*/bin/lrplay.elf)",
  "timeout": 30,
  "retries": 2
 },
 {
  "wait": 0.5
 },
 {
  "type": "$P --client /system/share/lazyrad/modplayer &"
 },
 {
  "key": "enter",
  "until": "TERM:CMD:$P --client /system/share/lazyrad/modplayer &",
  "timeout": 30,
  "retries": 1
 },
 {
  "wait_for": "LRPLAY:UP:PASS",
  "timeout": 120
 },
 {
  "wait": 2
 },
 {
  "shot": "01_loaded"
 },
 {
  "click_at": {
   "window": "MOD Player",
   "widget": "play_button"
  },
  "until": "LRPLAY:MODPLAY:PASS",
  "timeout": 30,
  "retries": 2
 },
 {
  "wait": 8
 },
 {
  "shot": "02_playing"
 },
 {
  "click_at": {
   "window": "MOD Player",
   "widget": "ch1_button"
  }
 },
 {
  "wait": 3
 },
 {
  "shot": "03_channel1_muted"
 },
 {
  "click_at": {
   "window": "MOD Player",
   "widget": "ch1_button"
  }
 },
 {
  "wait": 1
 },
 {
  "click_at": {
   "window": "MOD Player",
   "widget": "pause_button"
  }
 },
 {
  "wait": 2
 },
 {
  "shot": "04_paused"
 },
 {
  "wait": 3
 },
 {
  "click_at": {
   "window": "MOD Player",
   "widget": "play_button"
  }
 },
 {
  "wait_for": "LRPLAY:MODEND:PASS",
  "timeout": 180
 },
 {
  "wait": 2
 },
 {
  "shot": "05_finished"
 },
 {
  "quit": true
 }
]

[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 420, "note": "image: LAZYOS_DESKTOP=1 LAZYOS_WEBD=1 LAZYOS_UI_PROBE=1 LAZYOS_XUI_AUTOSTART=term, with rhai; docs/webd.md. Measures webd idle, with a view and stopped (the tasks and memory topics of sysmond), then stops and starts it"},
  {"wait_for": "WEBD:UP:PASS", "timeout": 240},
  {"wait_for": "WEBD:SERVE:app.os.lazy.webd.light", "timeout": 60},
  {"wait_for": "TERM:UP:PASS", "timeout": 240},
  {"wait": 1.0},
  {"type": "echo 'let e = msg::subscribe(\"system/stats/tasks\").next(5000);' > /tmp/t.rhai"},
  {"key": "enter"}, {"wait": 0.6},
  {"type": "echo 'let w = 0; let p = 0; let n = 0; let b = 0;' >> /tmp/t.rhai"},
  {"key": "enter"}, {"wait": 0.6},
  {"type": "echo 'for t in e.payload.tasks { let m = t.name.to_lower();' >> /tmp/t.rhai"},
  {"key": "enter"}, {"wait": 0.6},
  {"type": "echo 'if m.contains(\"webd\") { w += t.cpu; b += 1; }' >> /tmp/t.rhai"},
  {"key": "enter"}, {"wait": 0.6},
  {"type": "echo 'if m.contains(\"webprocess\") { p += t.cpu; }' >> /tmp/t.rhai"},
  {"key": "enter"}, {"wait": 0.6},
  {"type": "echo 'if m.contains(\"networkp\") { n += t.cpu; } }' >> /tmp/t.rhai"},
  {"key": "enter"}, {"wait": 0.6},
  {"type": "echo 'print(\"CPU w=\" + w + \" p=\" + p + \" n=\" + n + \" thr=\" + b);' >> /tmp/t.rhai"},
  {"key": "enter"}, {"wait": 0.6},
  {"type": "echo 'let e = msg::subscribe(\"system/stats/memory\").next(5000);' > /tmp/m.rhai"},
  {"key": "enter"}, {"wait": 0.6},
  {"type": "echo 'let m = e.payload;' >> /tmp/m.rhai"},
  {"key": "enter"}, {"wait": 0.6},
  {"type": "echo 'print(\"MEM live=\" + m.frames_live + \" free=\" + m.frames_free);' >> /tmp/m.rhai"},
  {"key": "enter"}, {"wait": 0.6},

  {"wait": 20.0, "note": "idle, no view"},
  {"type": "rhai /tmp/m.rhai"}, {"key": "enter", "until": "TERM:OUT:MEM live=", "timeout": 60, "retries": 1},
  {"type": "rhai /tmp/t.rhai"}, {"key": "enter", "until": "TERM:OUT:CPU w=", "timeout": 60, "retries": 1},
  {"wait": 60.0, "note": "sixty idle seconds"},
  {"type": "rhai /tmp/m.rhai"}, {"key": "enter", "until": "TERM:OUT:MEM live=", "timeout": 60, "retries": 1},
  {"type": "rhai /tmp/t.rhai"}, {"key": "enter", "until": "TERM:OUT:CPU w=", "timeout": 60, "retries": 1},

  {"type": "rhai -e 'sys::init::launch(\"os.lazy.webd\", \"/selftest/hold\", 0)'"},
  {"key": "enter", "until": "INIT:LAUNCH:EXISTING app=os.lazy.webd", "timeout": 60, "retries": 1},
  {"wait_for": "WEBD:SELFTEST:HOLD", "timeout": 240},
  {"wait": 8.0},
  {"type": "rhai /tmp/m.rhai"}, {"key": "enter", "until": "TERM:OUT:MEM live=", "timeout": 60, "retries": 1},
  {"type": "rhai /tmp/t.rhai"}, {"key": "enter", "until": "TERM:OUT:CPU w=", "timeout": 60, "retries": 1},
  {"wait_for": "WEBD:SELFTEST:PASS", "timeout": 120},
  {"wait": 5.0},
  {"type": "rhai /tmp/m.rhai"}, {"key": "enter", "until": "TERM:OUT:MEM live=", "timeout": 60, "retries": 1},
  {"type": "rhai /tmp/t.rhai"}, {"key": "enter", "until": "TERM:OUT:CPU w=", "timeout": 60, "retries": 1},

  {"type": "rhai -e 'sys::init::stop(\"os.lazy.webd\")'"},
  {"key": "enter", "until": "INIT:STOP:DONE app=os.lazy.webd", "timeout": 60, "retries": 0},
  {"wait_for": "WEBD:QUIT:PASS", "timeout": 60},
  {"wait": 5.0},
  {"type": "rhai /tmp/m.rhai"}, {"key": "enter", "until": "TERM:OUT:MEM live=", "timeout": 60, "retries": 1},

  {"type": "rhai -e 'sys::init::launch(\"os.lazy.webd\", \"\", 0)'"},
  {"key": "enter", "until": "INIT:LAUNCH:PASS app=os.lazy.webd", "timeout": 60, "retries": 1},
  {"wait_for": "WEBD:UP:PASS", "timeout": 120, "occurrence": 2},
  {"wait_for": "WEBD:SERVE:app.os.lazy.webd.light", "timeout": 60, "occurrence": 2},
  {"wait": 10.0},
  {"type": "rhai /tmp/m.rhai"}, {"key": "enter", "until": "TERM:OUT:MEM live=", "timeout": 60, "retries": 1},
  {"type": "rhai -e 'sys::init::launch(\"os.lazy.webd\", \"/selftest\", 0)'"},
  {"key": "enter", "until": "INIT:LAUNCH:EXISTING app=os.lazy.webd", "timeout": 60, "retries": 1},
  {"wait_for": "WEBD:SELFTEST:PASS", "timeout": 240, "occurrence": 2},
  {"wait": 1.0},
  {"shot": "01_end"},
  {"quit": true}
]

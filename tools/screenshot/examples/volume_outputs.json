[
  {"wait_for": "SHELL:TRAY:SERVICE:PASS", "timeout": 240, "note": "image: LAZYOS_DESKTOP=1 LAZYOS_UI_PROBE=1 LAZYOS_XUI_AUTOSTART=term LAZYOS_USB=1 LAZYOS_USB_AUDIO=1; run with a virtio-sound card and QEMU's usb-audio on one audiodev (docs/usb-audio-plan.md, Several outputs): --extra-arg=-audiodev --extra-arg=wav,id=a0,path=shots/volume_outputs/out.wav --extra-arg=-device --extra-arg=virtio-sound-pci,audiodev=a0 --extra-arg=-device --extra-arg=qemu-xhci,id=xhciaudio --extra-arg=-device --extra-arg=usb-audio,bus=xhciaudio.0,audiodev=a0"},
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 420},
  {"wait_for": "TERM:UP:PASS", "timeout": 240},
  {"wait_for": "VOLUME:UP:PASS", "timeout": 240},
  {"wait_for": "AUDIOD:CARD id=usb-audio0", "timeout": 240, "note": "USB ranks first: the mixer plays through it"},
  {"wait_for": "VOLUME:OUTPUTS usb-audio0,virtio-snd0", "timeout": 60, "note": "the applet lists both, the playing one first"},
  {"wait_for": "SHELL:TRAY:SET app=os.lazy.volume", "timeout": 60},
  {"move_to": {"target": "tray:os.lazy.volume"}},
  {"wait_for": "SHELL:TRAY:TOOLTIP app=os.lazy.volume", "timeout": 30},
  {"wait": 1.0},
  {"shot": "01_tooltip_usb"},
  {"click_at": {"target": "tray:os.lazy.volume"}, "button": "right", "until": "SHELL:TRAY:MENU:OPEN app=os.lazy.volume", "timeout": 30, "retries": 2},
  {"wait": 1.0},
  {"shot": "02_menu_two_outputs"},
  {"click_at": {"target": "traymenu:Virtual sound card"}, "until": "VOLUME:OUTPUT:virtio-snd0", "timeout": 30, "retries": 1},
  {"wait": 2.0, "note": "the mixer switches on its next step (AUDIOD:CARD id=virtio-snd0)"},
  {"click_at": {"window": "Terminal"}, "note": "focus the Terminal"},
  {"wait": 0.8},
  {"type": "mixer outputs"},
  {"key": "enter", "until": "TERM:OUT", "timeout": 30, "retries": 0},
  {"wait": 1.0},
  {"shot": "03_mixer_outputs"},
  {"click_at": {"target": "tray:os.lazy.volume"}, "button": "right", "until": "SHELL:TRAY:MENU:OPEN app=os.lazy.volume", "timeout": 30, "retries": 2},
  {"wait": 1.0},
  {"shot": "04_menu_virtio_checked"},
  {"click_at": {"target": "traymenu:USB: QEMU USB Audio"}, "until": "VOLUME:OUTPUT:usb-audio0", "timeout": 30, "retries": 1},

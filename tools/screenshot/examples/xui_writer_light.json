[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 420},
  {"wait_for": "TERM:UP:PASS", "timeout": 240},
  {"at": 3.0, "type": "confctl set sys/ui/mode str light"},
  {"at": 18.0, "key": "enter", "until": "TERM:CMD:confctl set sys/ui/mode str light", "timeout": 60, "retries": 2},
  {"wait_for": "THEME:APPLIED", "timeout": 60},
  {"at": 2.0, "type": "/apps/os.lazy.writer/*/bin/writer.elf --client &", "note": "started after the switch: an app reads the theme once, at start"},
  {"at": 20.0, "key": "enter", "until": "TERM:CMD:/apps/os.lazy.writer/*/bin/writer.elf --client &", "timeout": 60, "retries": 2},
  {"wait_for": "WRITER:UP:PASS", "timeout": 240, "note": "the app's stdout is the Terminal, which reports it as TERM:OUT"},
  {"at": 3.0, "shot": "01_light_started"},
  {"at": 3.5, "type": "LazyWriter in the light theme, with one bold word"},
  {"at": 23.0, "key_down": "ctrl"},
  {"at": 23.3, "key_down": "shift"},
  {"at": 23.6, "key": "left"},
  {"at": 23.9, "key_up": "shift"},
  {"at": 24.2, "key_up": "ctrl"},
  {"at": 25.0, "key_down": "ctrl"},
  {"at": 25.3, "key": "b"},
  {"at": 25.6, "key_up": "ctrl"},
  {"at": 26.5, "key": "end"},
  {"at": 30.0, "shot": "02_light_bold"},
  {"at": 30.5, "key_down": "ctrl"},
  {"at": 30.8, "key": "n"},
  {"at": 31.1, "key_up": "ctrl"},
  {"at": 35.0, "shot": "03_light_unsaved_prompt"},
  {"at": 35.5, "key": "esc"},
  {"at": 39.0, "shot": "04_light_prompt_cancelled"},
  {"at": 40.0, "quit": true}
]

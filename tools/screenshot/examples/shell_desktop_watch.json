[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 600, "note": "build with LAZYOS_DESKTOP=1 LAZYOS_AUTOLOGIN=user LAZYOS_XUI_AUTOSTART=term LAZYOS_UI_PROBE=1: the shell polls the desktop folder by its own stat and lists it only when that moved (xui-app/src/shell/deskscan.rs); a file made from the Terminal must still show up, and a removed one go"},
  {"wait_for": "TERM:UP:PASS", "timeout": 300},
  {"wait_for": "SHELL:DESKTOP:PASS icons=6", "timeout": 300},
  {"at": 2.0, "click_at": {"window": "Terminal"}, "note": "focus the Terminal"},
  {"wait": 1.5},
  {"at": 0.4, "type": "PS1='#"},
  {"at": 0.4, "type": " '"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:PS1='# '", "timeout": 30, "retries": 2},
  {"at": 0.4, "type": "cd &&"},
  {"at": 0.4, "type": " touc"},
  {"at": 0.4, "type": "h Des"},
  {"at": 0.4, "type": "ktop/"},
  {"at": 0.4, "type": "new.t"},
  {"at": 0.4, "type": "xt"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:cd && touch Desktop/new.txt", "timeout": 30, "retries": 2},
  {"wait_for": "SHELL:DESKTOP:ICONS n=7", "timeout": 60, "note": "the folder's own stamp moved: one listing, seven icons"},
  {"at": 2.0, "shot": "01_seven_icons"},
  {"at": 0.4, "type": "rm De"},
  {"at": 0.4, "type": "sktop"},
  {"at": 0.4, "type": "/new."},
  {"at": 0.4, "type": "txt"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:rm Desktop/new.txt", "timeout": 30, "retries": 2},
  {"wait_for": "SHELL:DESKTOP:ICONS n=6", "occurrence": 2, "timeout": 60, "note": "and removed again"},
  {"at": 2.0, "shot": "02_six_icons"},
  {"at": 6.0, "quit": true}
]

  {"wait": 0.5},
  {"type": "ls -ld ~ | cut -c1-10"},
  {"key": "enter", "until": "TERM:OUT:drwx------", "timeout": 30, "retries": 2},
  {"wait": 0.5},
  {"type": "ls /home/owner 2>/dev/null; echo O=$?"},
  {"key": "enter", "until": "TERM:OUT:O=[1-9]", "regex": true, "timeout": 30, "retries": 2},
  {"wait": 2.0},
  {"shot": "09_logged_in_as_bob"},
  {"wait": 6.0, "note": "past the 5 s flusher: the next boot reads this volume"},
  {"quit": true}

[
  {"wait_for": "GREETER:SETUP:UP", "timeout": 400, "note": "docs/accounts-plan.md U1/U2: build with LAZYOS_DESKTOP=1 LAZYOS_SETUP=1 LAZYOS_AUTOLOGIN=none LAZYOS_XUI_AUTOSTART=term,settings LAZYOS_UI_PROBE=1 LAZYOS_RESET_OS=1"},
  {"wait_for": "UI:RECT .*name=window:Log in", "regex": true, "timeout": 60},
  {"wait": 1.0},
  {"shot": "01_setup"},
  {"click_at": {"window": "Log in", "offset": [27, -69]}, "note": "first-boot setup: the owner's name"},
  {"wait": 0.5},
  {"type": "owner"},
  {"click_at": {"window": "Log in", "offset": [27, -33]}},
  {"wait": 0.5},
  {"type": "ownerpw1"},
  {"click_at": {"window": "Log in", "offset": [27, 3]}},
  {"wait": 0.5},
  {"type": "ownerpw1"},
  {"wait": 0.5},
  {"click_at": {"window": "Log in", "offset": [-23, 39]}, "note": "Create account"},
  {"wait_for": "ACCOUNTS:CREATE:PASS user=owner uid=1000 admin=1 by=setup", "timeout": 120},
  {"wait_for": "INIT:HOME:PASS op=create user=owner", "timeout": 120},
  {"wait_for": "GREETER:SETUP:PASS user=owner", "timeout": 120},
  {"wait_for": "LOGIN:OK:PASS user=owner uid=1000", "timeout": 120},
  {"wait_for": "SETTINGS:UP:PASS", "timeout": 240},
  {"wait_for": "TERM:UP:PASS", "timeout": 240},
  {"wait_for": "UI:RECT .*name=window:Terminal", "regex": true, "timeout": 60},
  {"wait": 3.0},
  {"click_at": {"window": "Settings", "offset": [-307, 132]}, "note": "raise Settings by its sidebar's Accounts row"},
  {"wait": 1.0},
  {"click_at": {"window": "Settings", "offset": [-307, 132]}, "until": "SETTINGS:MSG:Section\\(7\\)", "regex": true, "timeout": 30, "retries": 1},
  {"wait": 2.0},
  {"shot": "02_accounts_page"},
  {"click_at": {"window": "Settings", "offset": [-84, 21]}, "note": "Add an account: name"},
  {"wait": 0.5},
  {"type": "bob"},
  {"click_at": {"window": "Settings", "offset": [52, 21]}},
  {"wait": 0.5},
  {"type": "bobpw123"},
  {"wait": 0.5},
  {"click_at": {"window": "Settings", "offset": [260, 21]}, "until": "XUID:PROMPT:UP", "timeout": 60, "retries": 1, "note": "Add: elevd shows the trusted prompt"},
  {"wait": 2.0},
  {"shot": "03_prompt_add"},
  {"type": "ownerpw1", "note": "the owner is an administrator: the name is filled in, the password field has the focus"},
  {"wait": 0.5},
  {"key": "ret", "until": "SETTINGS:ACCOUNTS:ADD:PASS user=bob admin=0", "timeout": 120},
  {"wait_for": "ELEVD:REQUEST op=account.create uid=1000 .*admin=owner outcome=granted", "regex": true, "timeout": 60},
  {"wait_for": "INIT:HOME:PASS op=create user=bob", "timeout": 60},
  {"wait": 2.0},
  {"shot": "04_bob_added"},
  {"click_at": {"window": "Settings", "offset": [-44, -143]}, "until": "SETTINGS:MSG:Accounts\\(Select\\(1\\)\\)", "regex": true, "timeout": 30, "retries": 1, "note": "select bob"},
  {"click_at": {"window": "Settings", "offset": [-83, -46]}, "until": "XUID:PROMPT:UP", "timeout": 60, "retries": 1, "note": "Make administrator: then cancel the prompt"},
  {"wait": 2.0},
  {"shot": "05_prompt_promote"},
  {"key": "esc", "until": "ELEVD:REQUEST op=account.admin .*outcome=cancelled", "regex": true, "timeout": 60, "retries": 1},
  {"wait": 2.0},
  {"shot": "06_promote_cancelled"},
  {"click_at": {"window": "Settings", "offset": [-84, 88]}, "note": "Change your password"},
  {"wait": 0.5},
  {"type": "ownerpw1"},
  {"click_at": {"window": "Settings", "offset": [52, 88]}},
  {"wait": 0.5},
  {"type": "ownerpw2"},
  {"click_at": {"window": "Settings", "offset": [188, 88]}},
  {"wait": 0.5},
  {"type": "ownerpw2"},
  {"click_at": {"window": "Settings", "offset": [-89, 124]}, "until": "SETTINGS:ACCOUNTS:PASSWORD:PASS user=owner", "timeout": 120, "retries": 1},
  {"wait_for": "ACCOUNTS:PASSWORD:PASS user=owner by=uid=1000", "timeout": 60},
  {"wait": 1.0},
  {"shot": "07_password_changed"},
  {"wait_for": "UI:RECT .*name=taskbar:logout", "regex": true, "timeout": 60},
  {"click_at": {"target": "taskbar:logout"}, "note": "log out, then log in as the new account"},
  {"wait_for": "SHELL:LOGOUT:ARMED", "timeout": 30},
  {"mouse_click": "left"},
  {"wait_for": "LOGIN:LOGOUT:PASS session=1", "timeout": 60},
  {"wait_for": "GREETER:UP:PASS", "occurrence": 2, "timeout": 120},
  {"wait": 1.5},
  {"click_at": {"window": "Log in", "offset": [27, -63]}},
  {"wait": 0.5},
  {"type": "bob"},
  {"click_at": {"window": "Log in", "offset": [27, -25]}},
  {"wait": 0.5},
  {"type": "bobpw123"},
  {"wait": 0.5},
  {"click_at": {"window": "Log in", "offset": [-43, 13]}},
  {"wait_for": "GREETER:LOGIN:PASS user=bob session=2", "timeout": 120},
  {"wait_for": "LOGIN:OK:PASS user=bob uid=1001 session=2", "timeout": 60},
  {"wait_for": "TERM:UP:PASS", "occurrence": 2, "timeout": 240},
  {"wait_for": "SETTINGS:UP:PASS", "occurrence": 2, "timeout": 240},
  {"wait": 3.0},
  {"click_at": {"window": "Terminal", "offset": [0, 120]}},
  {"wait": 0.5},
  {"type": "PS1='# '"},
  {"key": "enter", "until": "TERM:CMD:PS1='# '", "timeout": 30, "retries": 2},
  {"wait": 0.5},
  {"type": "id -un; id -u"},
  {"key": "enter", "until": "TERM:OUT:1001", "timeout": 30, "retries": 2},
  {"wait": 0.5},
  {"type": "ls -ld ~ | cut -c1-10"},
  {"key": "enter", "until": "TERM:OUT:drwx------", "timeout": 30, "retries": 2},
  {"wait": 0.5},
  {"type": "ls /home/owner 2>/dev/null; echo O=$?"},
  {"key": "enter", "until": "TERM:OUT:O=[1-9]", "regex": true, "timeout": 30, "retries": 2},
  {"wait": 2.0},
  {"shot": "08_logged_in_as_bob"},
  {"wait": 6.0, "note": "past the 5 s flusher: the next boot reads this volume"},
  {"quit": true}
]

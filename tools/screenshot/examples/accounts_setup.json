  {"key": "ret", "until": "SETTINGS:ACCOUNTS:ADD:PASS user=bob admin=0", "timeout": 120},
  {"wait_for": "ELEVD:REQUEST op=account.create uid=1000 .*admin=owner outcome=granted", "regex": true, "timeout": 60},
  {"wait_for": "INIT:HOME:PASS op=create user=bob", "timeout": 60},
  {"wait": 2.0},
  {"shot": "04_bob_added"},
  {"click_at": {"window": "Settings", "offset": [-40, -152]}, "until": "SETTINGS:MSG:Accounts\\(Select\\(1\\)\\)", "regex": true, "timeout": 30, "retries": 1, "note": "select bob"},
  {"click_at": {"window": "Settings", "offset": [-87, -68]}, "until": "XUID:PROMPT:UP", "timeout": 60, "retries": 1, "note": "Make administrator: then cancel the prompt"},
  {"wait": 2.0},
  {"shot": "05_prompt_promote"},

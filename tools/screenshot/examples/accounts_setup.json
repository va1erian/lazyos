[
  {"wait_for": "GREETER:SETUP:UP", "timeout": 400, "note": "docs/accounts-plan.md U1/U2: build with LAZYOS_DESKTOP=1 LAZYOS_SETUP=1 LAZYOS_XUI_AUTOSTART=term,settings (a setup image logs nobody in) LAZYOS_UI_PROBE=1 LAZYOS_RESET_OS=1"},
  {"wait_for": "UI:RECT .*name=window:Log in", "regex": true, "timeout": 60},

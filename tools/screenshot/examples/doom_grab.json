[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 600},
  {"wait_for": "TERM:UP:PASS", "timeout": 300},
  {"wait_for": "PKGD:UP:PASS", "timeout": 120},
  {"wait_for": "PKGD:RECONCILE:PASS", "timeout": 120},
  {"at": 2.0, "click_at": {"window": "Terminal"}, "note": "focus the Terminal"},
  {"at": 4.6, "shot": "01_terminal"},
  {"at": 0.4, "type": "PS1='#"},
  {"at": 0.4, "type": " '"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:PS1='# '", "timeout": 30, "retries": 2},
  {"at": 0.4, "type": "cp /sy"},
  {"at": 0.4, "type": "stem/s"},
  {"at": 0.4, "type": "hare/s"},
  {"at": 0.4, "type": "amples"},
  {"at": 0.4, "type": "/doom."},
  {"at": 0.4, "type": "lzp ~/"},
  {"at": 0.4, "type": " && ec"},
  {"at": 0.4, "type": "ho sta"},
  {"at": 0.4, "type": "ged"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:cp /system/share/samples/doom.lzp ~/ && echo staged", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:staged", "timeout": 120},
  {"at": 0.4, "type": "pkgctl"},
  {"at": 0.4, "type": " insta"},
  {"at": 0.4, "type": "ll ~/d"},
  {"at": 0.4, "type": "oom.lz"},
  {"at": 0.4, "type": "p"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:pkgctl install ~/doom.lzp", "timeout": 30, "retries": 2},
  {"wait_for": "PKGD:INSTALL:PASS org.lazy.doom", "timeout": 900},
  {"wait_for": "TERM:OUT:PKGCTL:INSTALL:PASS", "timeout": 60},
  {"at": 1.0, "shot": "02_installed"},
  {"at": 0.4, "type": "pkgctl"},
  {"at": 0.4, "type": " list|"},
  {"at": 0.4, "type": "grep -"},
  {"at": 0.4, "type": "q 'doo"},
  {"at": 0.4, "type": "m.* us"},
  {"at": 0.4, "type": "er$'&&"},
  {"at": 0.4, "type": "echo D"},
  {"at": 0.4, "type": "OOM:US"},
  {"at": 0.4, "type": "ER"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:pkgctl list|grep -q 'doom.* user$'&&echo DOOM:USER", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:DOOM:USER", "timeout": 60},
  {"at": 1.0, "click_at": {"target": "taskbar:start"}, "until": "SHELL:MENU:OPEN", "timeout": 30, "retries": 2},
  {"at": 1.0, "move_to": {"menu": "Games"}, "until": "SHELL:SUBMENU:OPEN category=games", "timeout": 30, "retries": 1},
  {"at": 1.0, "move_to": {"menu": "Doom"}},
  {"at": 2.5, "shot": "04_menu_with_doom"},
  {"at": 3.0, "click_at": {"menu": "Doom"}, "until": "SHELL:LAUNCH:PASS app=org.lazy.doom", "timeout": 60, "retries": 1},
  {"wait_for": "PKGD:LAUNCH:LABEL app:org.lazy.doom", "timeout": 60},
  {"wait_for": "DOOM:UP:PASS mode=window", "timeout": 300},
  {"wait_for": "DOOM:KEYSTATE:PASS", "timeout": 60},
  {"wait": 0.5},
  {"move_to": {"window": "Freedoom"}, "timeout": 30},
  {"wait": 6.0},
  {"shot": "01_window"},
  {"key_down": "ctrl"},
  {"key": "esc", "until": "SHELL:MENU:OPEN", "timeout": 30},
  {"key_up": "ctrl"},
  {"wait": 1.0},
  {"shot": "02_menu_without_grab"},
  {"click_at": {"window": "Freedoom"}, "until": "SHELL:MENU:CLOSE", "timeout": 30},
  {"wait": 1.5},
  {"click_at": {"window": "Freedoom", "offset": [293, -212]}, "until": "DOOM:GRAB:ON", "timeout": 60},
  {"wait_for": "XUID:GRAB:HELD surface=[0-9]+", "regex": true, "timeout": 30},
  {"wait": 2.0},
  {"shot": "03_maximized_grabbed"},
  {"key_down": "ctrl"},
  {"key": "esc"},
  {"key_up": "ctrl"},
  {"wait": 1.5},
  {"shot": "04_doom_menu_under_grab"},
  {"key_down": "alt"},
  {"key": "tab"},
  {"key_up": "alt"},
  {"wait": 1.0},
  {"shot": "05_alt_tab_under_grab"},
  {"key": "esc"},
  {"key_down": "ctrl"},
  {"key_down": "alt"},
  {"key": "esc", "until": "INPUTD:GRAB:ESCAPE", "timeout": 30},
  {"key_up": "alt"},
  {"key_up": "ctrl"},
  {"wait_for": "DOOM:GRAB:OFF reason=4", "timeout": 30},
  {"wait_for": "XUID:GRAB:HELD surface=none", "timeout": 30},
  {"wait": 1.0},
  {"key_down": "ctrl"},
  {"key": "esc", "until": "SHELL:MENU:OPEN", "timeout": 30},
  {"key_up": "ctrl"},
  {"wait": 1.0},
  {"shot": "06_menu_after_escape"},
  {"click_at": {"window": "Freedoom"}, "until": "SHELL:MENU:CLOSE", "timeout": 30},
  {"wait": 1.0},
  {"quit": true}
]

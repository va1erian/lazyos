[
  {"wait_for": "LazyOS login: ", "timeout": 400},
  {"at": 1.0, "type": "user"},
  {"at": 1.6, "key": "enter"},
  {"at": 2.2, "type": "lazy"},
  {"at": 2.8, "key": "enter", "until": "LOGIN:OK:PASS user=user uid=1000", "timeout": 60, "retries": 1},
  {"wait": 4.0},
  {"type": "echo ENV:$HOME:$USER:$PATH"},
  {"key": "enter", "until": "(?m)^ENV:/home/user:user:/system/bin", "regex": true, "timeout": 30, "retries": 2},
  {"type": "pwd"},
  {"key": "enter", "until": "(?m)^/home/user", "regex": true, "timeout": 30, "retries": 2},
  {"type": "ls /home/admin; echo PERM:home_admin=$?"},
  {"key": "enter", "until": "(?m)^PERM:home_admin=[1-9]", "regex": true, "timeout": 30, "retries": 2},
  {"type": "ls /conf; echo PERM:conf=$?"},
  {"key": "enter", "until": "(?m)^PERM:conf=[1-9]", "regex": true, "timeout": 30, "retries": 2},
  {"type": "cat /logs/kernel.log; echo PERM:kernel_log=$?"},
  {"key": "enter", "until": "(?m)^PERM:kernel_log=[1-9]", "regex": true, "timeout": 30, "retries": 2},
  {"type": "echo mine > note.txt && cat /home/user/note.txt"},
  {"key": "enter", "until": "(?m)^mine", "regex": true, "timeout": 30, "retries": 2},
  {"wait": 1.0},
  {"shot": "accounts_user"},
  {"type": "exit"},
  {"key": "enter"},
  {"wait_for": "LazyOS login: ", "occurrence": 2, "timeout": 60},
  {"at": 1.0, "type": "admin"},
  {"at": 1.6, "key": "enter"},
  {"at": 2.2, "type": "nimda"},
  {"at": 2.8, "key": "enter", "until": "LOGIN:OK:PASS user=admin uid=1001", "timeout": 60, "retries": 1},
  {"wait": 4.0},
  {"type": "echo ENV:$HOME:$USER"},
  {"key": "enter", "until": "(?m)^ENV:/home/admin:admin", "regex": true, "timeout": 30, "retries": 2},
  {"type": "pwd"},
  {"key": "enter", "until": "(?m)^/home/admin", "regex": true, "timeout": 30, "retries": 2},
  {"type": "ls /home/admin >/dev/null; echo PERM:admin=$?"},
  {"key": "enter", "until": "(?m)^PERM:admin=0", "regex": true, "timeout": 30, "retries": 2},
  {"type": "ls /conf; echo PERM:admin_conf=$?"},
  {"key": "enter", "until": "(?m)^PERM:admin_conf=[1-9]", "regex": true, "timeout": 30, "retries": 2},
  {"wait": 1.0},
  {"shot": "accounts_admin"},
  {"quit": true}
]

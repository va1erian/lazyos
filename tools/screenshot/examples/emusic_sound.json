[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 600},
  {"wait_for": "TERM:UP:PASS", "timeout": 300},
  {"wait_for": "PKGD:UP:PASS", "timeout": 120},
  {"wait_for": "PKGD:RECONCILE:PASS", "timeout": 120},
  {"at": 2.0, "click_at": {"window": "Terminal"}, "note": "focus the Terminal"},
  {"at": 0.4, "type": "PS1='#"},
  {"at": 0.4, "type": " '"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:PS1='# '", "timeout": 30, "retries": 2},
  {"at": 0.4, "type": "cp /sy"},
  {"at": 0.4, "type": "stem/s"},
  {"at": 0.4, "type": "hare/s"},
  {"at": 0.4, "type": "amples"},
  {"at": 0.4, "type": "/emusi"},
  {"at": 0.4, "type": "c.lzp "},
  {"at": 0.4, "type": "~/ && "},
  {"at": 0.4, "type": "echo s"},
  {"at": 0.4, "type": "taged"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:cp /system/share/samples/emusic.lzp ~/ && echo staged", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:staged", "timeout": 120},
  {"at": 0.4, "type": "pkgctl"},
  {"at": 0.4, "type": " insta"},
  {"at": 0.4, "type": "ll ~/e"},
  {"at": 0.4, "type": "music."},
  {"at": 0.4, "type": "lzp"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:pkgctl install ~/emusic.lzp", "timeout": 30, "retries": 2},
  {"wait_for": "PKGD:INSTALL:PASS org.lazy.emusic", "timeout": 900},
  {"wait_for": "TERM:OUT:PKGCTL:INSTALL:PASS", "timeout": 60},
  {"at": 0.4, "type": "cd /ap"},
  {"at": 0.4, "type": "ps/org"},
  {"at": 0.4, "type": ".lazy."},
  {"at": 0.4, "type": "emusic"},
  {"at": 0.4, "type": "/*/res"},
  {"at": 0.4, "type": "ources"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:cd /apps/org.lazy.emusic/*/resources", "timeout": 30, "retries": 2},
  {"at": 0.4, "type": "mkdir "},
  {"at": 0.4, "type": "~/Musi"},
  {"at": 0.4, "type": "c; cp "},
  {"at": 0.4, "type": "tones."},
  {"at": 0.4, "type": "mp3 ~/"},
  {"at": 0.4, "type": "Music/"},
  {"at": 0.4, "type": " && cd"},
  {"at": 0.4, "type": " && ec"},
  {"at": 0.4, "type": "ho cop"},
  {"at": 0.4, "type": "ied"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:mkdir ~/Music; cp tones.mp3 ~/Music/ && cd && echo copied", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:copied", "timeout": 120},
  {"at": 0.5, "shot": "01_installed"},
  {"at": 0.4, "type": "cd /ap"},
  {"at": 0.4, "type": "ps/org"},
  {"at": 0.4, "type": ".lazy."},
  {"at": 0.4, "type": "emusic"},
  {"at": 0.4, "type": "/*/bin"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:cd /apps/org.lazy.emusic/*/bin", "timeout": 30, "retries": 2},
  {"at": 0.4, "type": "./emus"},
  {"at": 0.4, "type": "ic.elf"},
  {"at": 0.4, "type": " --sou"},
  {"at": 0.4, "type": "nd-che"},
  {"at": 0.4, "type": "ck ~/M"},
  {"at": 0.4, "type": "usic/t"},
  {"at": 0.4, "type": "ones.m"},
  {"at": 0.4, "type": "p3|tai"},
  {"at": 0.4, "type": "l -1;s"},
  {"at": 0.4, "type": "ync"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:./emusic.elf --sound-check ~/Music/tones.mp3|tail -1;sync", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:EMUSIC:CHECK:DONE", "timeout": 180},
  {"at": 0.5, "shot": "02_checked"},
  {"at": 1.0, "quit": true}
]

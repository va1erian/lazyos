[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 420},
  {"wait_for": "TERM:UP:PASS", "timeout": 240},
  {"at": 2.0, "type": "PS1='# '"},
  {"key": "enter"},
  {"wait": 2.0},
  {"type": "tty; stty size"},
  {"key": "enter", "until": "TERM:OUT:/dev/pts/", "timeout": 60, "retries": 1},
  {"wait": 1.0},
  {"type": "dash -c 'echo DASH:$((6*7))'"},
  {"key": "enter", "until": "TERM:OUT:DASH:42", "timeout": 60, "retries": 1},
  {"wait": 1.0},
  {"type": "lua -e 'print(\"LUA:\"..2^10)'"},
  {"key": "enter", "until": "TERM:OUT:LUA:1024", "timeout": 60, "retries": 1},
  {"wait": 1.0},
  {"type": "sqlite3 :memory: 'select 6*7'"},
  {"key": "enter", "until": "TERM:OUT:42", "timeout": 60, "retries": 1},
  {"wait": 1.0},
  {"type": "echo '[1,2,3]' | jq -c 'map(.*2)'"},
  {"key": "enter", "until": "TERM:OUT:[2,4,6]", "timeout": 60, "retries": 1},
  {"wait": 1.0},
  {"type": "rg -l 'Linux ABI' /docs/os | wc -l"},
  {"key": "enter", "until": "TERM:OUT:", "timeout": 90, "retries": 1},
  {"wait": 2.0},
  {"shot": "01_desktop_programs"},
  {"type": "vi /tmp/vi.txt"},
  {"key": "enter"},
  {"wait": 4.0},
  {"type": "iHello from vi on LazyOS"},
  {"key": "enter"},
  {"wait": 1.0},
  {"type": "second line"},
  {"wait": 2.0},
  {"key": "esc"},
  {"wait": 2.0},
  {"shot": "02_desktop_vi"},
  {"type": ":wq"},
  {"key": "enter"},
  {"wait": 4.0},
  {"type": "cat /tmp/vi.txt"},
  {"key": "enter", "until": "TERM:OUT:Hello from vi on LazyOS", "timeout": 60, "retries": 1},
  {"wait": 1.0},
  {"type": "seq 1 200 | less"},
  {"key": "enter"},
  {"wait": 4.0},
  {"type": " "},
  {"wait": 3.0},
  {"shot": "03_desktop_less"},
  {"type": "q"},
  {"wait": 2.0},
  {"type": "dash"},
  {"key": "enter"},
  {"wait": 3.0},
  {"type": "echo IN:$((2+3))"},
  {"key": "enter", "until": "TERM:OUT:IN:5", "timeout": 60},
  {"wait": 1.0},
  {"type": "sleep 30"},
  {"key": "enter"},
  {"wait": 3.0},
  {"key_down": "ctrl"},
  {"key": "c"},
  {"key_up": "ctrl"},
  {"wait": 2.0},
  {"type": "echo after-ctrl-c"},
  {"key": "enter", "until": "TERM:OUT:after-ctrl-c", "timeout": 20},
  {"wait": 2.0},
  {"shot": "04_desktop_dash"},
  {"type": "exit"},
  {"key": "enter"},
  {"wait": 2.0},
  {"quit": true}
]

[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 420, "note": "issue #161: the Alt+Tab overlay over two windows; image: LAZYOS_DESKTOP=1 LAZYOS_UI_PROBE=1 LAZYOS_XUI_AUTOSTART=term,editor"},
  {"wait_for": "TERM:UP:PASS", "timeout": 240},
  {"wait_for": "EDITOR:UP:PASS", "timeout": 240},
  {"wait_for": "XUID:WM:OPENED id=\\d+ windows=2", "regex": true, "timeout": 60},
  {"wait": 1.5},
  {"shot": "01_two_windows"},
  {"key_down": "alt"},
  {"wait": 0.2},
  {"key": "tab", "until": "XUID:WM:ALTTAB n=2", "timeout": 20},
  {"wait": 0.6},
  {"shot": "02_overlay_first_tab"},
  {"key": "tab", "until": "XUID:WM:ALTTAB n=2", "timeout": 20, "note": "a second Tab moves the selection on"},
  {"wait": 0.6},
  {"shot": "03_overlay_second_tab"},
  {"key": "tab", "until": "XUID:WM:ALTTAB n=2", "timeout": 20},
  {"wait": 0.3},
  {"key_up": "alt", "until": "XUID:WM:ALTTAB:COMMIT", "timeout": 20},
  {"wait": 1.0},
  {"shot": "04_committed"},
  {"key_down": "alt", "note": "Escape cancels the overlay: the focus stays"},
  {"wait": 0.2},
  {"key": "tab", "until": "XUID:WM:ALTTAB n=2", "timeout": 20},
  {"wait": 0.3},
  {"key": "esc"},
  {"wait": 0.3},
  {"key_up": "alt"},
  {"wait": 1.0},
  {"shot": "05_cancelled"},
  {"quit": true}
]

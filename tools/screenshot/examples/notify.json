[
  {"wait_for": "SHELL:NOTIFY:SERVICE:PASS", "timeout": 300, "note": "image: LAZYOS_DESKTOP=1 LAZYOS_UI_PROBE=1 LAZYOS_XUI_AUTOSTART=term LAZYOS_RESET_OS=1, with rhai (tools/rhai/build.py); the same session runs on a --hidpi image (docs/notify-plan.md section 8)"},
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 420},
  {"wait_for": "TERM:UP:PASS", "timeout": 300},
  {"wait_for": "SHELL:NOTIFY:SETTINGS", "timeout": 120, "note": "confd answered: motion and do-not-disturb are read"},
  {"wait": 1.0},

  {"click_at": {"window": "Terminal"}, "note": "focus the Terminal"},
  {"wait": 0.5},
  {"type": "echo 'let a = os::args();' > /tmp/n.rhai"},
  {"key": "enter", "until": "TERM:CMD:echo 'let a = os::args();' > /tmp/n.rhai", "timeout": 30, "retries": 2},
  {"type": "echo 'sys::notify::notify(a[0],a[1],a[2],(),[],(),(),());' >> /tmp/n.rhai"},
  {"key": "enter", "until": "TERM:CMD:echo 'sys::notify::notify(a[0]", "timeout": 30, "retries": 2},

  {"type": "rhai /tmp/n.rhai Info Hello 'A plain notice'"},
  {"key": "enter", "until": "SHELL:NOTIFY:POST owner=<terminal> id=1 level=info", "timeout": 60, "retries": 1},
  {"wait": 0.12},
  {"shot": "01_info_sliding"},
  {"wait": 0.9},
  {"shot": "02_info_settled"},

  {"type": "rhai /tmp/n.rhai Success Saved 'All changes written'"},
  {"key": "enter", "until": "SHELL:NOTIFY:POST owner=<terminal> id=2 level=success", "timeout": 60, "retries": 1},
  {"wait": 0.18},
  {"shot": "03_success_tick_drawing"},
  {"type": "rhai /tmp/n.rhai Warn 'Low disk space' 'Only 120 MB are left on /home'"},
  {"key": "enter", "until": "SHELL:NOTIFY:POST owner=<terminal> id=3 level=warn", "timeout": 60, "retries": 1},
  {"wait": 1.5},
  {"shot": "04_three_levels"},
  {"wait_for": "SHELL:NOTIFY:CLOSE id=1 reason=timeout", "timeout": 60, "note": "Info and Success time out after 5 s, Warn stays"},
  {"wait_for": "SHELL:NOTIFY:CLOSE id=2 reason=timeout", "timeout": 60},
  {"wait": 1.0},
  {"shot": "05_warn_stays_others_reflowed"},
  {"click_at": {"target": "toast:dismiss"}, "until": "SHELL:NOTIFY:CLOSE id=3 reason=user", "timeout": 30, "retries": 2},
  {"wait": 0.8},

  {"type": "echo 'sys::notify::notify(\"Error\",\"Backup failed\",\"The disk was removed before the copy finished\",(),[#{id:1,label:\"Retry\"},#{id:2,label:\"Details\"}],(),(),());' > /tmp/a.rhai"},
  {"key": "enter", "until": "TERM:CMD:echo 'sys::notify::notify(\"Error\"", "timeout": 30, "retries": 2},
  {"type": "rhai /tmp/a.rhai"},
  {"key": "enter", "until": "SHELL:NOTIFY:POST owner=<terminal> id=4 level=error", "timeout": 60, "retries": 1},
  {"wait": 1.5},
  {"shot": "06_action_toast"},
  {"click_at": {"target": "toast:retry"}, "until": "SHELL:NOTIFY:ACTION id=4 action=1", "timeout": 30, "retries": 2},
  {"wait_for": "SHELL:NOTIFY:CLOSE id=4 reason=user", "timeout": 30},
  {"wait": 0.8},

  {"type": "echo 'let a = os::args();' > /tmp/p.rhai"},
  {"key": "enter", "until": "TERM:CMD:echo 'let a = os::args();' > /tmp/p.rhai", "timeout": 30, "retries": 2},
  {"type": "echo 'let r = if a.len() > 1 { a[1].parse_int() } else { () };' >> /tmp/p.rhai"},
  {"key": "enter", "until": "TERM:CMD:echo 'let r = if a.len()", "timeout": 30, "retries": 2},
  {"type": "echo 'sys::notify::notify(\"Info\",\"Copying photos\",a[0] + \"%\",(),[],a[0].parse_int(),r,());' >> /tmp/p.rhai"},
  {"key": "enter", "until": "TERM:CMD:echo 'sys::notify::notify(\"Info\",\"Copying", "timeout": 30, "retries": 2},
  {"type": "rhai /tmp/p.rhai 10"},
  {"key": "enter", "until": "SHELL:NOTIFY:POST owner=<terminal> id=5 level=info title=Copying photos", "timeout": 60, "retries": 1},
  {"wait": 1.0},
  {"shot": "07_progress_10"},
  {"type": "rhai /tmp/p.rhai 70 5"},
  {"key": "enter", "until": "SHELL:NOTIFY:POST owner=<terminal> id=5 level=info title=Copying photos", "occurrence": 2, "timeout": 60, "retries": 1},
  {"wait": 0.12},
  {"shot": "08_progress_filling"},
  {"wait": 0.6},
  {"shot": "09_progress_70"},
  {"type": "rhai /tmp/p.rhai 100 5"},
  {"key": "enter", "until": "SHELL:NOTIFY:POST owner=<terminal> id=5 level=info title=Copying photos", "occurrence": 3, "timeout": 60, "retries": 1},
  {"wait_for": "SHELL:NOTIFY:CLOSE id=5 reason=timeout", "timeout": 60, "note": "one toast the whole time: replaced in place, then it timed out"},
  {"wait": 0.8},

  {"type": "echo 'for i in 0..6 { sys::notify::notify(\"Info\",\"Device \" + i + \" connected\",\"\",(),[],(),(),()); }' > /tmp/b.rhai"},
  {"key": "enter", "until": "TERM:CMD:echo 'for i in 0..6", "timeout": 30, "retries": 2},
  {"type": "rhai /tmp/b.rhai"},
  {"key": "enter", "until": "SHELL:NOTIFY:POST owner=<terminal> id=11 level=info", "timeout": 60, "retries": 1},
  {"wait": 1.5},
  {"shot": "10_burst_three_visible"},
  {"wait_for": "SHELL:NOTIFY:CLOSE id=6 reason=timeout", "timeout": 60, "note": "the first three time out; the other three were merged into one summary"},
  {"wait": 1.5},
  {"shot": "11_burst_summary"},
  {"wait": 8},
  {"shot": "12_empty"},
  {"quit": true}
]

[
  {"wait_for": "/ #", "timeout": 300},
  {"wait_for": "NETD:RESOLV wrote", "timeout": 300},
  {"wait": 5.0},
  {"type": "m=T1; ok() { if grep -q -- \"$1\"; then echo $m:$2:PASS; else echo $m:$2:FAIL; fi; }", "delay": 0.05},
  {"key": "enter", "until": "/ #", "timeout": 60, "retries": 1},
  {"type": "no() { if grep -q -- \"$1\"; then echo $m:$2:FAIL; else echo $m:$2:PASS; fi; }", "delay": 0.05},
  {"key": "enter", "until": "/ #", "timeout": 60, "retries": 1},
  {"type": "cat /etc/resolv.conf; cat /etc/resolv.conf | ok 'nameserver 10.0.2.3' resolv", "delay": 0.05},
  {"key": "enter", "until": "T1:resolv:", "timeout": 120, "retries": 1},
  {"type": "cat /etc/hosts; cat /etc/hosts | ok '127.0.0.1.localhost' hosts", "delay": 0.05},
  {"key": "enter", "until": "T1:hosts:", "timeout": 60, "retries": 1},
  {"type": "ls /etc | ok ssl etcls; ls /etc/ssl/certs | ok ca-certificates.crt certsls", "delay": 0.05},
  {"key": "enter", "until": "T1:certsls:", "timeout": 60, "retries": 1},
  {"type": "head -c 100 /etc/ssl/certs/ca-certificates.crt; echo", "delay": 0.05},
  {"key": "enter", "until": "/ #", "timeout": 60, "retries": 1},
  {"type": "grep -c 'BEGIN CERT' /etc/ssl/certs/ca-certificates.crt | ok '^1[0-9][0-9]$' bundle", "delay": 0.05},
  {"key": "enter", "until": "T1:bundle:", "timeout": 60, "retries": 1},
  {"type": "echo x > /etc/resolv.conf; cat /etc/resolv.conf | no '^x$' readonly", "delay": 0.05},
  {"key": "enter", "until": "T1:readonly:", "timeout": 60, "retries": 1},
  {"type": "touch /etc/ssl/certs/mine.pem; ls /etc/ssl/certs | no mine readonlydir", "delay": 0.05},
  {"key": "enter", "until": "T1:readonlydir:", "timeout": 60, "retries": 1},
  {"type": "nslookup github.com 2>&1 | tail -3; nslookup github.com 2>&1 | ok Address nslookup", "delay": 0.05},
  {"key": "enter", "until": "T1:nslookup:", "timeout": 120, "retries": 1},
  {"type": "wget 2>&1 | ok 'ABI:' wget; /usr/bin/wget 2>&1 | ok 'ABI:' usrbinwget", "delay": 0.05},
  {"key": "enter", "until": "T1:usrbinwget:", "timeout": 120, "retries": 1},
  {"type": "curl 2>&1 | ok 'ABI:' curl; fetch 2>&1 | ok 'ABI:' fetch", "delay": 0.05},
  {"key": "enter", "until": "T1:fetch:", "timeout": 120, "retries": 1},
  {"wait": 1.0},
  {"shot": "01_etc"},
  {"quit": true}
]

[
  {"wait_for": "DEVICES:UP:PASS", "timeout": 240},
  {"at": 3.0, "shot": "01_devices_app"},
  {"at": 3.5, "key_down": "alt"},
  {"at": 3.7, "key": "tab"},
  {"at": 3.9, "key_up": "alt"},
  {"at": 5.0, "type": "devctl"},
  {"at": 5.5, "key": "enter", "until": "TERM:OUT:ID  CLASS", "timeout": 60, "retries": 2},
  {"at": 1.0, "type": "devctl rules"},
  {"at": 1.5, "key": "enter", "until": "TERM:OUT:UID", "timeout": 60, "retries": 2},
  {"at": 1.0, "type": "devctl denials"},
  {"at": 1.5, "key": "enter", "until": "TERM:CMD:devctl denials", "timeout": 60, "retries": 2},
  {"at": 4.0, "shot": "02_devctl_in_terminal"},
  {"at": 4.5, "key_down": "alt"},
  {"at": 4.7, "key": "tab"},
  {"at": 4.9, "key_up": "alt"},
  {"at": 6.0, "type": "r", "until": "DEVICES:REFRESH:PASS", "timeout": 30, "retries": 2},
  {"at": 8.0, "shot": "03_devices_refreshed"},
  {"at": 9.0, "quit": true}
]

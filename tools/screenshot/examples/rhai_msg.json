[
  {"wait_for": "TERM:UP:PASS", "timeout": 240},
  {"wait": 2},
  {"type": "echo 'let s=msg::services();let ok=[];'>/tmp/m"},
  {"key": "enter", "until": "TERM:CMD:echo 'let s=msg::services();let ok=[];'>/tmp/m", "timeout": 30, "retries": 1},
  {"wait": 0.3},
  {"type": "echo 'if s.contains(\"os.lazy.confd\"){ok+=\"services\"}'>>/tmp/m"},
  {"key": "enter", "until": "TERM:CMD:echo 'if s.contains(\"os.lazy.confd\"){ok+=\"services\"}'>>/tmp/m", "timeout": 30, "retries": 1},
  {"wait": 0.3},
  {"type": "echo 'let c=msg::connect(\"os.lazy.confd.v1\");'>>/tmp/m"},
  {"key": "enter", "until": "TERM:CMD:echo 'let c=msg::connect(\"os.lazy.confd.v1\");'>>/tmp/m", "timeout": 30, "retries": 1},
  {"wait": 0.3},
  {"type": "echo 'if c.info().store_dir!=\"\"{ok+=\"confd\"}'>>/tmp/m"},
  {"key": "enter", "until": "TERM:CMD:echo 'if c.info().store_dir!=\"\"{ok+=\"confd\"}'>>/tmp/m", "timeout": 30, "retries": 1},
  {"wait": 0.3},
  {"type": "echo 'c.set(\"user/1000/rhai\",#{kind:3,str_value:\"hi\"});'>>/tmp/m"},
  {"key": "enter", "until": "TERM:CMD:echo 'c.set(\"user/1000/rhai\",#{kind:3,str_value:\"hi\"});'>>/tmp/m", "timeout": 30, "retries": 1},
  {"wait": 0.3},
  {"type": "echo 'let v=c.get(\"user/1000/rhai\").str_value;'>>/tmp/m"},
  {"key": "enter", "until": "TERM:CMD:echo 'let v=c.get(\"user/1000/rhai\").str_value;'>>/tmp/m", "timeout": 30, "retries": 1},
  {"wait": 0.3},
  {"type": "echo 'if v==\"hi\"{ok+=\"roundtrip\"}'>>/tmp/m"},
  {"key": "enter", "until": "TERM:CMD:echo 'if v==\"hi\"{ok+=\"roundtrip\"}'>>/tmp/m", "timeout": 30, "retries": 1},
  {"wait": 0.3},
  {"type": "echo 'let t=msg::connect(\"os.lazy.messenger.topics.v1\");'>>/tmp/m"},
  {"key": "enter", "until": "TERM:CMD:echo 'let t=msg::connect(\"os.lazy.messenger.topics.v1\");'>>/tmp/m", "timeout": 30, "retries": 1},
  {"wait": 0.3},
  {"type": "echo 't.ping();let n=t.list_topics();'>>/tmp/m"},
  {"key": "enter", "until": "TERM:CMD:echo 't.ping();let n=t.list_topics();'>>/tmp/m", "timeout": 30, "retries": 1},
  {"wait": 0.3},
  {"type": "echo 'if type_of(n)==\"array\"{ok+=\"topics\"}'>>/tmp/m"},
  {"key": "enter", "until": "TERM:CMD:echo 'if type_of(n)==\"array\"{ok+=\"topics\"}'>>/tmp/m", "timeout": 30, "retries": 1},
  {"wait": 0.3},
  {"type": "echo 'let r=\"\";try{c.get(\"nope/x\")}catch(e){r=e}'>>/tmp/m"},
  {"key": "enter", "until": "TERM:CMD:echo 'let r=\"\";try{c.get(\"nope/x\")}catch(e){r=e}'>>/tmp/m", "timeout": 30, "retries": 1},
  {"wait": 0.3},
  {"type": "echo 'if r.contains(\"confd.v1.Get\"){ok+=\"refused\"}'>>/tmp/m"},
  {"key": "enter", "until": "TERM:CMD:echo 'if r.contains(\"confd.v1.Get\"){ok+=\"refused\"}'>>/tmp/m", "timeout": 30, "retries": 1},
  {"wait": 0.3},
  {"type": "echo 'let m=\"os.lazy.echo.v1\";'>>/tmp/m"},
  {"key": "enter", "until": "TERM:CMD:echo 'let m=\"os.lazy.echo.v1\";'>>/tmp/m", "timeout": 30, "retries": 1},
  {"wait": 0.3},
  {"type": "echo 'try{msg::connect(m)}catch{ok+=\"missing\"}'>>/tmp/m"},
  {"key": "enter", "until": "TERM:CMD:echo 'try{msg::connect(m)}catch{ok+=\"missing\"}'>>/tmp/m", "timeout": 30, "retries": 1},
  {"wait": 0.3},
  {"type": "echo 'print(\"RHAI:\"+\"msg:\"+ok.len());print(ok)'>>/tmp/m"},
  {"key": "enter", "until": "TERM:CMD:echo 'print(\"RHAI:\"+\"msg:\"+ok.len());print(ok)'>>/tmp/m", "timeout": 30, "retries": 1},

[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 420, "note": "needs an image built with LAZYOS_DESKTOP=1 LAZYOS_USB=1 LAZYOS_UI_PROBE=1 LAZYOS_XUI_AUTOSTART=files; launch with a qemu-xhci controller and `-drive if=none,id=fat0,format=raw,file=<a FAT stick made by fatstick>` (tools/storage/fat_run.py shows the arguments)"},
  {"wait_for": "FILES:UP:PASS", "timeout": 240},
  {"wait_for": "FILES:DIR:/", "timeout": 60},
  {"wait_for": "MOUNTD:USERS", "timeout": 120, "note": "mountd knows who is logged in"},
  {"at": 1.0, "shot": "01_files_root"},
  {"qmp": "device_add", "args": {"driver": "usb-storage", "bus": "xhci.0", "drive": "fat0", "id": "usbfat0"}, "note": "plug the stick in"},
  {"wait_for": "FATFUSE:UP /media/MY_STICK", "timeout": 120},
  {"at": 0.5, "click_at": {"window": "Files", "offset": [0, 228]}, "timeout": 30, "note": "focus Files (its status bar)"},
  {"wait": 1.0},
  {"at": 0.3, "key_down": "ctrl"},
  {"at": 0.3, "key": "l", "note": "Ctrl+L: an empty address bar"},
  {"at": 0.3, "key_up": "ctrl"},
  {"at": 0.5, "type": "/media/MY_STICK"},
  {"at": 0.5, "key": "enter", "until": "FILES:DIR:/media/MY_STICK", "timeout": 60, "retries": 1, "note": "the stick is a folder like any other"},
  {"wait": 3.0},
  {"shot": "02_stick_in_files"},
  {"at": 0.3, "key_down": "ctrl"},
  {"at": 0.3, "key": "l"},
  {"at": 0.3, "key_up": "ctrl"},
  {"at": 0.5, "type": "/media/MY_STICK/docs"},
  {"at": 0.5, "key": "enter", "until": "FILES:DIR:/media/MY_STICK/docs", "timeout": 60, "retries": 1},
  {"wait": 3.0},
  {"shot": "03_stick_docs"},
  {"qmp": "device_del", "args": {"id": "usbfat0"}, "note": "pull it"},
  {"wait_for": "fuse: /media/MY_STICK unmounted", "timeout": 60},
  {"wait": 2.0},
  {"at": 0.3, "key_down": "ctrl"},
  {"at": 0.3, "key": "l"},
  {"at": 0.3, "key_up": "ctrl"},
  {"at": 0.5, "type": "/media"},
  {"at": 0.5, "key": "enter", "until": "FILES:DIR:/media", "timeout": 60, "retries": 1, "note": "/media is empty again"},
  {"wait": 3.0},
  {"shot": "04_media_empty"},
  {"quit": true}
]

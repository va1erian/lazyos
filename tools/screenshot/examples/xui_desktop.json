[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 420},
  {"wait_for": "TERM:UP:PASS", "timeout": 240},
  {"wait_for": "SYSMON:UP:PASS", "timeout": 240},
  {"wait_for": "FABMON:UP:PASS", "timeout": 240},
  {"wait_for": "XUIAPP:COUNTER:PASS", "timeout": 240},
  {"at": 2.0, "shot": "01_desktop_apps"},
  {"at": 2.0, "mouse_move": [-300, -300]},
  {"at": 2.2, "mouse_move": [-300, -300]},
  {"at": 2.4, "mouse_move": [-300, -300]},
  {"at": 2.6, "mouse_move": [-300, -300]},
  {"at": 2.8, "mouse_move": [-300, -300]},
  {"at": 3.0, "mouse_move": [-300, -300]},
  {"at": 3.4, "mouse_move": [44, 704], "note": "taskbar: Start"},
  {"at": 3.8, "mouse_click": "left", "until": "SHELL:MENU:OPEN", "timeout": 30, "retries": 2},
  {"at": 1.0, "mouse_move": [90, -104], "note": "start menu: the System row (134,600)"},
  {"wait_for": "SHELL:SUBMENU:OPEN category=system", "timeout": 30},
  {"mouse_move": [204, 72], "note": "System submenu: Terminal (338,672)"},
  {"at": 0.5, "mouse_click": "left", "until": "SHELL:LAUNCH:PASS app=terminal", "timeout": 30, "retries": 1},
  {"wait_for": "TERM:UP:PASS", "occurrence": 2, "timeout": 120, "note": "the new Terminal has the focus"},
  {"at": 4.6, "shot": "01b_terminal_focused"},
  {"at": 5.2, "type": "echo $((6*7))"},
  {"at": 3.5, "key": "enter", "until": "TERM:CMD:echo $((6*7))", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:42", "timeout": 30},
  {"at": 2.0, "type": "cat /system/share/samples/hello.txt"},
  {"at": 2.5, "key": "enter", "until": "TERM:CMD:cat /system/share/samples/hello.txt", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:Hello from LazyOS!", "timeout": 30},
  {"at": 2.0, "type": "confctl; echo native-status=$?"},
  {"at": 2.5, "key": "enter", "until": "TERM:CMD:confctl; echo native-status=$?", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:usage: confctl <get|set|delete|list|watch> [args]", "timeout": 60},
  {"at": 1.0, "shot": "02_terminal_shell"},
  {"at": 9.0, "key_down": "alt"},
  {"at": 9.2, "key": "tab"},
  {"at": 9.5, "key_up": "alt"},
  {"at": 10.5, "shot": "03_alt_tab_next"},
  {"at": 11.0, "key_down": "alt"},
  {"at": 11.2, "key": "tab"},
  {"at": 11.5, "key_up": "alt"},
  {"at": 12.5, "shot": "04_alt_tab_next2"},
  {"at": 13.5, "quit": true}
]

[
  {"wait_for": "TERM:UP:PASS", "timeout": 240},
  {"wait_for": "SYSMON:UP:PASS", "timeout": 120},
  {"wait_for": "FABMON:UP:PASS", "timeout": 120},
  {"wait_for": "XUIAPP:COUNTER:PASS", "timeout": 120},
  {"at": 2.0, "shot": "01_desktop_apps"},
  {"at": 3.0, "type": "echo $((6*7))"},
  {"at": 3.5, "key": "enter", "until": "TERM:CMD:echo $((6*7))", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:42", "timeout": 30},
  {"at": 2.0, "type": "cat HELLO.TXT"},
  {"at": 2.5, "key": "enter", "until": "TERM:CMD:cat HELLO.TXT", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:Hello from LazyOS!", "timeout": 30},
  {"at": 1.0, "shot": "02_terminal_shell"},
  {"at": 9.0, "key_down": "alt"},
  {"at": 9.2, "key": "tab"},
  {"at": 9.5, "key_up": "alt"},
  {"at": 10.5, "shot": "03_alt_tab_next"},
  {"at": 11.0, "key_down": "alt"},
  {"at": 11.2, "key": "tab"},
  {"at": 11.5, "key_up": "alt"},
  {"at": 12.5, "shot": "04_alt_tab_next2"},
  {"at": 13.5, "quit": true}
]

[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 420},
  {"wait_for": "FILES:UP:PASS", "timeout": 240},
  {"wait_for": "FILES:DIR:/", "timeout": 60},
  {"at": 1.5, "shot": "01_files_root"},
  {"at": 0.5, "click_at": {"window": "Files", "offset": [0, 228]}, "timeout": 30, "note": "focus Files (its status bar); the probe keeps the creation title until the first navigation"},
  {"wait": 1.0},
  {"at": 0.3, "key_down": "ctrl"},
  {"at": 0.3, "key": "l", "note": "Ctrl+L: an empty address bar"},
  {"at": 0.3, "key_up": "ctrl"},
  {"at": 0.5, "type": "/docs/os"},
  {"at": 0.5, "key": "enter", "until": "FILES:DIR:/docs/os", "timeout": 30, "retries": 1, "note": "go: the same window shows /docs/os"},
  {"wait_for": "name=window:os", "timeout": 30},
  {"at": 1.5, "shot": "02_docs_os_icons"},
  {"at": 0.5, "click_at": {"window": "os", "offset": [339, -221]}, "note": "the view switch (rightmost toolbar button): details"},
  {"wait": 1.5, "note": "after a click, `at` would fire at once (it counts from the last wait_for)"},
  {"shot": "03_docs_os_details"},
  {"at": 0.3, "key_down": "alt"},
  {"at": 0.3, "key": "up", "until": "FILES:DIR:/docs", "timeout": 30, "retries": 1, "note": "Alt+Up: /docs with os selected"},
  {"at": 0.3, "key_up": "alt"},
  {"at": 1.5, "shot": "04_docs_up"},
  {"at": 0.3, "key_down": "alt"},
  {"at": 0.3, "key": "left", "until": "FILES:DIR:/docs/os", "timeout": 30, "retries": 1, "note": "Alt+Left: back to /docs/os"},
  {"at": 0.3, "key_up": "alt"},
  {"at": 1.5, "shot": "05_back"},
  {"at": 0.3, "key_down": "ctrl"},
  {"at": 0.3, "key": "l"},
  {"at": 0.3, "key_up": "ctrl"},
  {"at": 0.5, "type": "README.md"},
  {"at": 0.5, "key": "enter", "until": "FILES:OPEN:PASS:/docs/os/README.md", "timeout": 60, "retries": 1, "note": "a file in the address bar opens with its app"},
  {"at": 12.0, "shot": "06_markdown_opened"},
  {"at": 1.0, "quit": true}
]

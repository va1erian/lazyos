[
  {"wait_for": "LazyOS login: ", "timeout": 400},
  {"at": 1.0, "type": "alice"},
  {"at": 1.6, "key": "enter"},
  {"at": 2.2, "type": "lazy"},
  {"at": 2.8, "key": "enter", "until": "LOGIN:OK:PASS user=alice", "timeout": 60, "retries": 1},
  {"wait": 4.0},
  {"type": "top"},
  {"key": "enter", "until": "SYS:TOP:PASS", "timeout": 60, "retries": 2},
  {"wait": 2.0},
  {"type": "echo status=$?"},
  {"key": "enter", "until": "status=0", "timeout": 30, "retries": 2},
  {"type": "confctl; echo status=$?"},
  {"key": "enter", "until": "status=1", "timeout": 60, "retries": 2},
  {"type": "nosuchcmd; echo status=$?"},
  {"key": "enter", "until": "status=127", "timeout": 30, "retries": 2},
  {"type": "confctl 2>&1 | sed s/usage/PIPED-USAGE/"},
  {"key": "enter", "until": "PIPED-USAGE: confctl", "timeout": 60, "retries": 2},
  {"type": "faultprobe null; echo fault=$?"},
  {"key": "enter", "until": "fault=139", "timeout": 60, "retries": 2},
  {"type": "top & echo bg-prompt-back"},
  {"key": "enter", "until": "(?m)^bg-prompt-back", "regex": true, "timeout": 30, "retries": 2},
  {"wait": 2.0},
  {"type": "wait; echo waited=$?"},
  {"key": "enter", "until": "waited=0", "timeout": 60, "retries": 2},
  {"wait": 1.5},
  {"shot": "native_exec_console"},
  {"quit": true}
]

[
  {"wait_for": "LazyOS interpreter \\(ring 3\\)", "regex": true, "timeout": 240},
  {"key": "tab"},
  {"type": "dir"},
  {"key": "enter", "until": "entries", "timeout": 60, "retries": 2},
  {"type": "type HELLO.TXT"},
  {"key": "enter", "until": "FAT16 disk image", "timeout": 30, "retries": 2},
  {"type": "mkdir /tmp/d"},
  {"key": "enter"},
  {"type": "copy HELLO.TXT /tmp/d"},
  {"key": "enter", "until": "copied [0-9]+ bytes to /tmp/d/HELLO.TXT", "regex": true, "timeout": 30, "retries": 2},
  {"type": "cd /tmp/d"},
  {"key": "enter", "until": "/tmp/d> ", "timeout": 30, "retries": 2},
  {"type": "ren HELLO.TXT NOTE.TXT"},
  {"key": "enter"},
  {"type": "dir"},
  {"key": "enter", "until": "NOTE.TXT\\s*\\n", "regex": true, "timeout": 30, "retries": 2},
  {"type": "del NOTE.TXT"},
  {"key": "enter"},
  {"type": "type NOTE.TXT"},
  {"key": "enter", "until": "no such file or directory", "timeout": 30, "retries": 2},
  {"type": "cd /"},
  {"key": "enter"},
  {"type": "del HELLO.TXT"},
  {"key": "enter", "until": "read-only file system", "timeout": 30, "retries": 2},
  {"type": "exec FAULTPRB.ELF null"},
  {"key": "enter", "until": "user: task [0-9]+ killed by page fault .*status 139\n(.*\n)*.*program killed by signal 11", "regex": true, "timeout": 60, "retries": 1},
  {"type": "exec FAULTPRB.ELF kernel"},
  {"key": "enter", "until": "user: task [0-9]+ killed by page fault .*status 139\n(.*\n)*.*program killed by signal 11", "regex": true, "timeout": 60, "retries": 1},
  {"type": "exec FAULTPRB.ELF priv"},
  {"key": "enter", "until": "user: task [0-9]+ killed by general protection fault .*status 139\n(.*\n)*.*program killed by signal 11", "regex": true, "timeout": 60, "retries": 1},
  {"type": "exec FAULTPRB.ELF div"},
  {"key": "enter", "until": "user: task [0-9]+ killed by divide error .*status 136\n(.*\n)*.*program killed by signal 8", "regex": true, "timeout": 60, "retries": 1},
  {"type": "exec FAULTPRB.ELF ud"},
  {"key": "enter", "until": "user: task [0-9]+ killed by invalid opcode .*status 132\n(.*\n)*.*program killed by signal 4", "regex": true, "timeout": 60, "retries": 1},
  {"type": "dir"},
  {"key": "enter", "until": "18 entries", "timeout": 30, "retries": 2},
  {"type": "mem"},
  {"key": "enter", "until": "heap: ", "timeout": 30, "retries": 2},
  {"shot": "dos"},
  {"quit": true}
]

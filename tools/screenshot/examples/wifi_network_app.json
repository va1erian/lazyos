[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 420, "note": "image: LAZYOS_DESKTOP=1 LAZYOS_NETD=1 LAZYOS_WIFI=1 LAZYOS_WIFI_SIM=1 LAZYOS_UI_PROBE=1 LAZYOS_XUI_AUTOSTART=network LAZYOS_RESET_OS=1; run by tools/wifi/ui_run.py, which starts the fake access points and gives QEMU the air card"},

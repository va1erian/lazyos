[
  {"wait_for": "SHELL:TRAY:SERVICE:PASS", "timeout": 240, "note": "issue #648, keys only in the menus; image: LAZYOS_DESKTOP=1 LAZYOS_TRAYDEMO=1 LAZYOS_UI_PROBE=1 LAZYOS_XUI_AUTOSTART=term"},
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 420},
  {"wait_for": "TERM:UP:PASS", "timeout": 240},
  {"wait": 1.5},

  {"key": "super", "until": "SHELL:MENU:OPEN", "timeout": 20, "retries": 1, "note": "Super pressed and released alone opens the start menu"},
  {"wait_for": "SHELL:KEYS:GRAB on", "timeout": 10},
  {"wait_for": "XUID:PANELKEYS:GRAB on", "timeout": 10},
  {"wait": 0.5},
  {"key": "down", "until": "SHELL:MENU:KEY:SELECT row=", "timeout": 10},
  {"key": "down", "until": "SHELL:MENU:KEY:SELECT row=Development", "timeout": 3, "retries": 8},
  {"wait": 0.8},
  {"shot": "01_start_menu_row_dark"},
  {"key": "right", "until": "SHELL:SUBMENU:OPEN category=development", "timeout": 10},
  {"key": "down", "until": "SHELL:SUBMENU:KEY:SELECT row=Tray Demo", "timeout": 3, "retries": 10},
  {"wait": 0.8},
  {"shot": "02_submenu_row_dark"},
  {"key": "left", "until": "SHELL:SUBMENU:KEY:BACK", "timeout": 10},
  {"key": "enter", "until": "SHELL:SUBMENU:OPEN category=development", "timeout": 10, "note": "Enter on a category row opens it too"},
  {"key": "down", "until": "SHELL:SUBMENU:KEY:SELECT row=Tray Demo", "timeout": 3, "retries": 10},
  {"key": "enter", "until": "INIT:LAUNCH:PASS app=os.lazy.traydemo", "timeout": 60},
  {"wait_for": "SHELL:MENU:CLOSE", "timeout": 10},
  {"wait_for": "TRAYDEMO:UP:PASS", "timeout": 240},
  {"wait_for": "SHELL:TRAY:SET app=os.lazy.traydemo", "timeout": 120},
  {"wait": 1.5},

  {"key_down": "super", "note": "Win+B: the keyboard goes to the tray"},
  {"wait": 0.2},
  {"key": "b", "until": "SHELL:TRAY:KEYS app=", "timeout": 10},
  {"key_up": "super"},
  {"wait": 0.3},
  {"key": "right", "until": "SHELL:TRAY:KEYS app=os.lazy.traydemo", "timeout": 3, "retries": 6},
  {"wait": 0.8},
  {"shot": "03_tray_focus_dark"},
  {"key": "down", "until": "SHELL:TRAY:MENU:OPEN app=os.lazy.traydemo", "timeout": 10},
  {"wait": 0.8},
  {"shot": "04_tray_menu_dark"},
  {"key": "down", "until": "SHELL:TRAY:MENU:KEY:SELECT row=Notifications", "timeout": 3, "retries": 8},
  {"key": "enter", "until": "TRAYDEMO:MENU:2:true", "timeout": 20},
  {"wait_for": "SHELL:TRAY:UPDATE app=os.lazy.traydemo", "timeout": 30},
  {"wait": 0.5},
  {"key": "down", "until": "SHELL:TRAY:MENU:OPEN app=os.lazy.traydemo", "timeout": 10},
  {"key": "down", "until": "SHELL:TRAY:MENU:KEY:SELECT row=Icon", "timeout": 3, "retries": 8},
  {"key": "right", "until": "name=traymenu:Pixels", "timeout": 10},
  {"wait": 0.8},
  {"shot": "05_tray_submenu_dark"},
  {"key": "left", "until": "SHELL:TRAY:MENU:KEY:BACK", "timeout": 10},
  {"key": "escape", "until": "SHELL:TRAY:MENU:CLOSE", "timeout": 10},
  {"key": "escape", "until": "SHELL:TRAY:KEYS:LEAVE", "timeout": 10},
  {"wait_for": "SHELL:KEYS:GRAB off", "timeout": 10},
  {"wait": 0.5},

  {"click_at": {"window": "Terminal", "offset": [250, 150]}, "note": "the pointer only to type the theme switch (below the demo window)"},
  {"wait": 0.5},
  {"type": "confctl set user/1000/ui/mode str light"},
  {"wait": 0.5},
  {"key": "enter", "until": "TERM:CMD:confctl set user/1000/ui/mode str light", "timeout": 30, "retries": 2},
  {"wait": 4.0},

  {"key_down": "ctrl", "note": "Ctrl+Esc opens the start menu too"},
  {"wait": 0.2},
  {"key": "esc", "until": "SHELL:MENU:OPEN", "timeout": 20},
  {"key_up": "ctrl"},
  {"wait": 0.5},
  {"key": "up", "until": "SHELL:MENU:KEY:SELECT row=Shut down...", "timeout": 10, "note": "Up from nothing lights the last row"},
  {"key": "up", "until": "SHELL:MENU:KEY:SELECT row=Restart...", "timeout": 10},
  {"wait": 0.8},
  {"shot": "06_start_menu_light"},
  {"key": "escape", "until": "SHELL:MENU:KEY:CLOSE", "timeout": 10},
  {"wait_for": "SHELL:MENU:CLOSE", "timeout": 10},

  {"key_down": "super"},
  {"wait": 0.2},
  {"key": "b", "until": "SHELL:TRAY:KEYS app=", "timeout": 10},
  {"key_up": "super"},
  {"wait": 0.3},
  {"key": "right", "until": "SHELL:TRAY:KEYS app=os.lazy.traydemo", "timeout": 3, "retries": 6},
  {"key": "down", "until": "SHELL:TRAY:MENU:OPEN app=os.lazy.traydemo", "timeout": 10},
  {"key": "end", "until": "SHELL:TRAY:MENU:KEY:SELECT row=Quit Tray Demo", "timeout": 10},
  {"wait": 0.8},
  {"shot": "07_tray_menu_light"},
  {"key": "enter", "until": "SHELL:TRAY:QUIT:ASK app=os.lazy.traydemo", "timeout": 10},
  {"wait_for": "SHELL:TRAY:CLEAR app=os.lazy.traydemo why=(gone|stopped)", "regex": true, "timeout": 30},
  {"key": "escape", "until": "SHELL:TRAY:KEYS:LEAVE", "timeout": 10},
  {"wait": 1.5},
  {"shot": "08_quit_by_key_light"},
  {"quit": true}
]

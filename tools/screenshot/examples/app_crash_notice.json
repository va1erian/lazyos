[
 {"wait_for": "PKGD:PROVISION:DONE", "timeout": 600},
 {"wait_for": "TERM:UP:PASS", "timeout": 300},
 {"wait_for": "PKGD:UP:PASS", "timeout": 120},
 {"wait_for": "SHELL:FAILURES:SUBSCRIBED", "timeout": 120},
 {"wait": 2},
 {"type": "cp /sy"},
 {"type": "stem/s"},
 {"type": "hare/s"},
 {"type": "amples"},
 {"type": "/crash"},
 {"type": "load.l"},
 {"type": "zp ~/ "},
 {"type": "&& ech"},
 {"type": "o stag"},
 {"type": "ed"},
 {"key": "enter", "until": "TERM:CMD:cp /system/share/samples/crashload.lzp ~/ && echo staged",
  "timeout": 30, "retries": 2},
 {"wait_for": "TERM:OUT:staged", "timeout": 120},
 {"type": "pkgctl"},
 {"type": " insta"},
 {"type": "ll ~/c"},
 {"type": "rashlo"},
 {"type": "ad.lzp"},
 {"key": "enter", "until": "TERM:CMD:pkgctl install ~/crashload.lzp", "timeout": 30, "retries": 2},
 {"wait_for": "PKGD:INSTALL:PASS org.lazy.crashload", "timeout": 300},
 {"wait_for": "TERM:OUT:PKGCTL:INSTALL:PASS", "timeout": 60},
 {"wait": 1},
 {"shot": "01_installed"},
 {"click_at": {"target": "taskbar:start"}, "until": "SHELL:MENU:OPEN", "timeout": 30, "retries": 2},
 {"wait": 1.5},
 {"move_to": {"menu": "Accessories"}, "until": "SHELL:SUBMENU:OPEN category=accessories",
  "timeout": 30, "retries": 1},
 {"wait": 0.4},
 {"shot": "02_menu"},
 {"click_at": {"menu": "crashload"}, "until": "INIT:LAUNCH:PASS app=org.lazy.crashload",
  "timeout": 60, "retries": 1},
 {"wait_for": "INIT:APP:FAILED app=org.lazy.crashload", "timeout": 180},
 {"wait_for": "SHELL:NOTICE:OPEN app=org.lazy.crashload", "timeout": 60},
 {"wait": 3},
 {"shot": "03_notice"},
 {"click_at": {"window": "crashload stopped", "widget": "restart"},
  "until": "SHELL:NOTICE:RESTART app=org.lazy.crashload", "timeout": 30, "retries": 2},
 {"wait_for": "SHELL:NOTICE:OPEN app=org.lazy.crashload", "occurrence": 2, "timeout": 180},
 {"wait": 3},
 {"shot": "04_notice_again"},
 {"click_at": {"window": "crashload stopped", "widget": "close"},
  "until": "SHELL:NOTICE:CLOSE app=org.lazy.crashload", "timeout": 30, "retries": 2},
 {"wait": 12},
 {"shot": "05_closed"},
 {"quit": true}
]

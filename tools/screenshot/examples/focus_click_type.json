[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 420, "note": "image: LAZYOS_DESKTOP=1 LAZYOS_UI_PROBE=1 LAZYOS_XUI_AUTOSTART=term, with rhai (tools/rhai/build.py)"},
  {"wait_for": "TERM:UP:PASS", "timeout": 240},
  {"wait_for": "UI:RECT .*name=window:Terminal", "regex": true, "timeout": 60},
  {"at": 2.0, "type": "echo FOCUS:READY"},
  {"key": "enter", "until": "TERM:OUT:FOCUS:READY", "timeout": 60, "retries": 2},
  {"type": "rhai -e 'sys::init::launch(\"os.lazy.counter\", \"\", 0)'"},
  {"key": "enter", "until": "XUIAPP:COUNTER:PASS", "timeout": 120, "note": "the new window takes the focus"},
  {"wait_for": "UI:RECT .*name=window:xui counter", "regex": true, "timeout": 60},
  {"at": 2.0, "shot": "01_counter_focused"},
  {"click_at": {"window": "Terminal", "offset": [250, 150]}, "timeout": 60, "note": "into the Terminal, outside the Counter, and type at once: a key read before xuid has handled the click must still reach the Terminal"},
  {"type": "echo AAAA"},
  {"key": "enter", "until": "TERM:CMD:echo AAAA", "timeout": 30, "note": "TERM:CMD:cho AAAA: the first key went to the Counter"},
  {"wait_for": "TERM:OUT:AAAA", "timeout": 30},
  {"key_down": "alt", "note": "Alt+Tab back to the Counter (the click below raised the Terminal over it)"},
  {"wait": 0.2},
  {"key": "tab"},
  {"wait": 0.2},
  {"key_up": "alt"},

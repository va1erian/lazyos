[
  {"wait_for": "INPUTD:CONSOLE:OPEN session=\\d+ owner=\\d+ focused=1", "regex": true, "timeout": 400},
  {"wait_for": "LOGIN:CONSOLE:INPUTD session=", "timeout": 60},
  {"wait_for": "LazyOS login: ", "timeout": 60},
  {"at": 1.0, "type": "user"},
  {"at": 1.6, "key": "enter"},
  {"at": 2.2, "type": "lazy"},
  {"at": 2.8, "key": "enter", "until": "LOGIN:OK:PASS user=user uid=1000", "timeout": 60, "retries": 1},
  {"wait": 4.0},
  {"type": "echo CLEAN:$?"},
  {"key": "enter", "until": "(?m)^CLEAN:0", "regex": true, "timeout": 30, "retries": 1},
  {"wait": 1.0},
  {"shot": "console_shell"},
  {"type": "exit"},
  {"key": "enter"},
  {"wait_for": "INPUTD:CONSOLE:OPEN session=", "occurrence": 2, "timeout": 60},
  {"wait_for": "LazyOS login: ", "occurrence": 2, "timeout": 60},
  {"at": 1.0, "type": "nobody"},
  {"at": 1.6, "key": "enter"},
  {"at": 2.2, "type": "x"},
  {"at": 2.8, "key": "enter", "until": "LOGIN:DENIED:PASS user=nobody reason=unknown-user", "timeout": 60, "retries": 1},
  {"wait": 1.0},
  {"shot": "console_denied"},
  {"quit": true}

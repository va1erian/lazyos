[
  {"wait_for": "XUID:WM:PASS", "timeout": 240, "note": "issue #161: snap, maximize, restore, minimize by Super+arrows and by dragging a title bar to a screen edge; image: LAZYOS_DESKTOP=1 LAZYOS_UI_PROBE=1 LAZYOS_XUI_AUTOSTART=editor (a resizable window)"},
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 420},
  {"wait_for": "EDITOR:UP:PASS", "timeout": 240},
  {"wait_for": "UI:RECT .*name=title:(Untitled - )?Editor", "regex": true, "timeout": 60},
  {"wait": 1.0},
  {"click_at": {"window": "Editor"}},
  {"wait": 0.5},

  {"key_down": "super"},
  {"wait": 0.2},
  {"key": "left", "until": "XUID:WM:SNAP side=left id=\\d+ windows=1 title=.*Editor", "regex": true, "timeout": 20},
  {"key_up": "super"},
  {"wait": 1.0},
  {"shot": "01_snap_left"},

  {"key_down": "super"},
  {"wait": 0.2},
  {"key": "right", "until": "XUID:WM:SNAP side=right id=\\d+ windows=1 title=.*Editor", "regex": true, "timeout": 20},
  {"key_up": "super"},
  {"wait": 1.0},
  {"shot": "02_snap_right"},

  {"key_down": "super"},
  {"wait": 0.2},
  {"key": "up", "until": "XUID:WM:MAXIMIZE id=\\d+ windows=1 title=.*Editor", "regex": true, "timeout": 20},
  {"key_up": "super"},
  {"wait": 1.0},
  {"shot": "03_maximized"},

  {"key_down": "super"},
  {"wait": 0.2},
  {"key": "down", "until": "XUID:WM:RESTORE id=\\d+ windows=1 title=.*Editor", "regex": true, "timeout": 20},
  {"wait": 0.5},
  {"key": "down", "until": "XUID:WM:MINIMIZE id=\\d+ windows=1 title=.*Editor", "regex": true, "timeout": 20},
  {"key_up": "super"},
  {"wait": 1.0},
  {"shot": "04_minimized"},

  {"key_down": "alt", "note": "Alt+Tab brings the minimized window back"},
  {"wait": 0.2},
  {"key": "tab", "until": "XUID:WM:ALTTAB n=1", "timeout": 20},
  {"wait": 0.5},
  {"shot": "05_alt_tab_overlay"},
  {"key_up": "alt"},
  {"wait_for": "XUID:WM:UNMINIMIZE id=\\d+ windows=1 title=.*Editor", "regex": true, "timeout": 20},
  {"wait_for": "XUID:WM:ALTTAB:COMMIT", "timeout": 20},
  {"wait": 1.0},
  {"shot": "06_restored_by_alt_tab"},

  {"move_to": {"target": "title:Untitled - Editor"}, "note": "drag the title bar onto the left edge"},
  {"wait": 0.3},
  {"mouse_down": "left"},
  {"wait": 0.2},
  {"mouse_move": [-150, 0]},
  {"wait": 0.1},
  {"mouse_move": [-150, 0]},
  {"wait": 0.1},
  {"mouse_move": [-150, 0]},
  {"wait": 0.1},
  {"mouse_move": [-150, 0]},
  {"wait": 0.3},
  {"mouse_up": "left", "until": "XUID:WM:SNAP side=left id=\\d+ windows=1 title=.*Editor", "regex": true, "timeout": 20},
  {"wait": 1.0},
  {"shot": "07_drag_snapped_left"},

  {"move_to": {"target": "title:Untitled - Editor"}, "note": "drag it to the top edge: maximize"},
  {"wait": 0.3},
  {"mouse_down": "left"},
  {"wait": 0.2},
  {"mouse_move": [200, -100]},
  {"wait": 0.1},
  {"mouse_move": [0, -100]},
  {"wait": 0.3},
  {"mouse_up": "left", "until": "XUID:WM:MAXIMIZE id=\\d+ windows=1 title=.*Editor", "regex": true, "timeout": 20},
  {"wait": 1.0},
  {"shot": "08_drag_maximized"},
  {"quit": true}
]

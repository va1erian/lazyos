[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 420},
  {"wait_for": "TERM:UP:PASS", "timeout": 120},
  {"wait_for": "NETD:ADDR 10.0.2.15/24 gw=10.0.2.2 dns=10.0.2.3 source=dhcp if=eth0", "timeout": 120},
  {"wait_for": "NETD:ADDR 10.0.3.15/24 gw=10.0.3.2 dns=10.0.3.3 source=dhcp if=eth1", "timeout": 60, "note": "needs --net --nics 2; build: LAZYOS_DESKTOP=1 LAZYOS_XUI_AUTOSTART=term LAZYOS_NETD=1 LAZYOS_NETD_ARGS=demo=0 LAZYOS_UI_PROBE=1 LAZYOS_RESET_OS=1"},
  {"at": 1.0, "type": "echo 'let i = msg::connect(\"os.lazy.init.v1\");' > /tmp/l.rhai"},
  {"at": 1.5, "key": "enter"},
  {"at": 2.5, "type": "echo 'for a in os::args() { print(i.launch(a, \"\", 0)); }' >> /tmp/l.rhai"},
  {"at": 3.0, "key": "enter"},
  {"at": 4.0, "type": "clear; rhai /tmp/l.rhai os.lazy.network"},
  {"at": 4.5, "key": "enter"},
  {"wait_for": "NETAPP:STATUS:PASS addr=10.0.2.15/24 gw=10.0.2.2", "timeout": 90},
  {"wait": 2.0},
  {"click_at": {"window": "Network", "offset": [-272, -3]}, "note": "Manual (static address) for eth0"},
  {"wait": 0.5},
  {"click_at": {"window": "Network", "offset": [-41, 33]}, "note": "the address field"},
  {"key_down": "ctrl"}, {"key": "a"}, {"key_up": "ctrl"},
  {"type": "10.0.2.20/24"},
  {"click_at": {"window": "Network", "offset": [-41, 105]}, "note": "the DNS field"},
  {"type": "10.0.2.3"},
  {"wait": 0.5},
  {"click_at": {"window": "Network", "offset": [-235, 141]}, "until": "XUID:PROMPT:UP", "timeout": 60, "retries": 1, "note": "Apply: the system setting goes through elevd, which shows the trusted prompt"},
  {"wait": 2.0},
  {"shot": "01_prompt_eth0"},
  {"type": "admin"},
  {"key": "tab"},
  {"type": "nimda"},
  {"key": "ret", "until": "NETAPP:APPLY:PASS mode=static if=eth0", "timeout": 120},
  {"wait_for": "ELEVD:REQUEST op=net.config uid=1000 .*admin=admin outcome=granted", "regex": true, "timeout": 60},
  {"wait_for": "NETD:ADDR 10.0.2.20/24 gw=10.0.2.2 dns=10.0.2.3 source=static if=eth0", "timeout": 60},
  {"wait": 2.0},
  {"shot": "03_eth0_static"},
  {"click_at": {"window": "Network", "offset": [93, 141]}, "note": "Next card: eth1"},
  {"wait": 2.0},
  {"click_at": {"window": "Network", "offset": [-272, -3]}, "note": "Manual for eth1"},
  {"wait": 0.5},
  {"click_at": {"window": "Network", "offset": [-41, 33]}},
  {"key_down": "ctrl"}, {"key": "a"}, {"key_up": "ctrl"},
  {"type": "10.0.3.30/24"},
  {"click_at": {"window": "Network", "offset": [-41, 105]}},
  {"type": "10.0.3.3"},
  {"wait": 0.5},
  {"shot": "04_eth1_form"},
  {"click_at": {"window": "Network", "offset": [-235, 141]}, "until": "XUID:PROMPT:UP", "timeout": 60, "retries": 1},
  {"wait": 1.0},
  {"type": "admin"},
  {"key": "tab"},
  {"type": "nimda"},
  {"key": "ret", "until": "NETAPP:APPLY:PASS mode=static if=eth1", "timeout": 120},
  {"wait_for": "NETD:ADDR 10.0.3.30/24 gw=10.0.3.2 dns=10.0.3.3 source=static if=eth1", "timeout": 60},
  {"wait": 2.0},
  {"shot": "05_both_static"},
  {"click_at": {"window": "Network", "offset": [-272, -31]}, "note": "Automatic (DHCP) for eth1"},
  {"wait": 0.5},
  {"click_at": {"window": "Network", "offset": [-235, 141]}, "until": "XUID:PROMPT:UP", "timeout": 60, "retries": 1},
  {"wait": 1.0},
  {"type": "admin"},
  {"key": "tab"},
  {"type": "nimda"},
  {"key": "ret", "until": "NETAPP:APPLY:PASS mode=dhcp if=eth1", "timeout": 120},
  {"wait_for": "NETD:ADDR 10.0.3.15/24 gw=10.0.3.2 dns=10.0.3.3 source=dhcp if=eth1", "timeout": 60, "occurrence": 2},
  {"click_at": {"window": "Network", "offset": [-122, 141]}, "until": "NETAPP:RENEW:(PASS|FAIL)", "regex": true, "timeout": 20, "retries": 1},
  {"wait_for": "NETAPP:RENEW:PASS", "timeout": 5},
  {"at": 3.0, "shot": "06_eth1_dhcp_renewed"},
  {"click_at": {"window": "Network", "offset": [-272, -3]}, "note": "Manual for eth1 again, to cancel the prompt (a cancel holds the next prompt back for seconds, so it comes last)"},
  {"wait": 0.5},
  {"click_at": {"window": "Network", "offset": [-235, 141]}, "until": "XUID:PROMPT:UP", "timeout": 60, "retries": 1},
  {"wait": 1.5},
  {"key": "esc", "until": "NETAPP:APPLY:FAIL", "timeout": 60, "retries": 1, "note": "cancelled: nothing is written"},
  {"wait": 2.0},
  {"shot": "07_cancelled"},
  {"at": 2.0, "quit": true}
]

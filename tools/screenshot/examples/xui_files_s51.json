[
  {"wait_for": "PKGD:PROVISION:DONE", "timeout": 600},
  {"wait_for": "TERM:UP:PASS", "timeout": 300},
  {"wait_for": "PKGD:RECONCILE:PASS", "timeout": 120},
  {"at": 2.0, "click_at": {"window": "Terminal"}, "note": "focus the Terminal"},
  {"wait": 1.5},
  {"at": 0.4, "type": "PS1='#"},
  {"at": 0.4, "type": " '"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:PS1='# '", "timeout": 30, "retries": 2},
  {"at": 0.4, "type": "cd && "},
  {"at": 0.4, "type": "rm -rf"},
  {"at": 0.4, "type": " box n"},
  {"at": 0.4, "type": "otes* "},
  {"at": 0.4, "type": "s.rhai"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:cd && rm -rf box notes* s.rhai", "timeout": 30, "retries": 2},
  {"at": 0.4, "type": "mkdir "},
  {"at": 0.4, "type": "box &&"},
  {"at": 0.4, "type": " echo "},
  {"at": 0.4, "type": "hi > n"},
  {"at": 0.4, "type": "otes.t"},
  {"at": 0.4, "type": "xt && "},
  {"at": 0.4, "type": "echo m"},
  {"at": 0.4, "type": "ade"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:mkdir box && echo hi > notes.txt && echo made", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:made", "timeout": 60},
  {"at": 0.4, "type": "rhai -"},
  {"at": 0.4, "type": "e 'sys"},
  {"at": 0.4, "type": "::mime"},
  {"at": 0.4, "type": "d::ope"},
  {"at": 0.4, "type": "n(\"/ho"},
  {"at": 0.4, "type": "me/adm"},
  {"at": 0.4, "type": "in/not"},
  {"at": 0.4, "type": "es.txt"},
  {"at": 0.4, "type": "\",\"rev"},
  {"at": 0.4, "type": "eal\")'"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:rhai -e 'sys::mimed::open(\"/home/admin/notes.txt\",\"reveal\")'", "timeout": 30, "retries": 2},
  {"wait_for": "FILES:REVEAL:PASS:/home/admin/notes.txt", "timeout": 120},
  {"wait_for": "FILES:UP:PASS", "timeout": 120},
  {"wait_for": "name=window:Files", "timeout": 60},
  {"at": 2.0, "shot": "01_revealed_home"},
  {"at": 0.5, "key": "enter", "until": "FILES:OPEN:PASS:/home/admin/notes.txt", "timeout": 60, "retries": 2, "note": "open the revealed notes.txt"},
  {"wait_for": "EDITOR:UP:PASS", "timeout": 120},
  {"at": 3.0, "shot": "02_editor"},
  {"at": 0.5, "click_at": {"window": "Files", "offset": [-345, 228]}, "note": "Files status bar: focus"},
  {"wait": 1.0},
  {"at": 0.5, "key_down": "ctrl"},
  {"at": 0.3, "key": "c", "until": "FILES:COPY:PASS:1", "timeout": 30, "retries": 1, "note": "copy notes.txt"},
  {"at": 0.3, "key_up": "ctrl"},
  {"at": 1.0, "shot": "03_copied"},
  {"at": 0.5, "key": "home", "until": "FILES:SELECTION:PASS", "timeout": 20, "retries": 1, "note": "select box"},
  {"at": 0.5, "key": "enter", "note": "open box"},
  {"wait_for": "name=window:box", "timeout": 60},
  {"at": 2.0, "click_at": {"window": "box", "offset": [0, 228]}, "note": "box status bar: focus"},
  {"wait": 1.0},
  {"at": 0.5, "key_down": "ctrl"},
  {"at": 0.3, "key": "v", "until": "FILES:PASTE:PASS:1:0", "timeout": 30, "retries": 1, "note": "paste into box"},
  {"at": 0.3, "key_up": "ctrl"},
  {"at": 2.0, "shot": "04_pasted"},
  {"at": 0.5, "key_down": "ctrl"},
  {"at": 0.3, "key": "v", "until": "FILES:PASTE:PASS:1:0", "timeout": 30, "retries": 1, "note": "paste again: notes (2).txt"},
  {"at": 0.3, "key_up": "ctrl"},
  {"at": 2.0, "shot": "05_pasted_again"},
  {"at": 0.5, "click_at": {"window": "Terminal", "offset": [-280, 0]}, "note": "focus the Terminal"},
  {"wait": 1.5},
  {"at": 0.4, "type": "echo b"},
  {"at": 0.4, "type": "ox/*"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:echo box/*", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:box/notes (2).txt box/notes.txt", "timeout": 60},
  {"at": 0.4, "type": "echo '"},
  {"at": 0.4, "type": "let s="},
  {"at": 0.4, "type": "sys::f"},
  {"at": 0.4, "type": "iles::"},
  {"at": 0.4, "type": "subscr"},
  {"at": 0.4, "type": "ibe_se"},
  {"at": 0.4, "type": "ssion_"},
  {"at": 0.4, "type": "select"},
  {"at": 0.4, "type": "ion();"},
  {"at": 0.4, "type": "'>s.rh"},
  {"at": 0.4, "type": "ai"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:echo 'let s=sys::files::subscribe_session_selection();'>s.rhai", "timeout": 30, "retries": 2},
  {"at": 0.4, "type": "echo '"},
  {"at": 0.4, "type": "print("},
  {"at": 0.4, "type": "\"SEL:\""},
  {"at": 0.4, "type": "+s.nex"},
  {"at": 0.4, "type": "t(3000"},
  {"at": 0.4, "type": ").payl"},
  {"at": 0.4, "type": "oad.fo"},
  {"at": 0.4, "type": "lder)'"},
  {"at": 0.4, "type": ">>s.rh"},
  {"at": 0.4, "type": "ai"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:echo 'print(\"SEL:\"+s.next(3000).payload.folder)'>>s.rhai", "timeout": 30, "retries": 2},
  {"at": 0.4, "type": "rhai s"},
  {"at": 0.4, "type": ".rhai"},
  {"at": 0.8, "key": "enter", "until": "TERM:CMD:rhai s.rhai", "timeout": 30, "retries": 2},
  {"wait_for": "TERM:OUT:SEL:/home/admin/box", "timeout": 60},
  {"at": 1.5, "shot": "06_selection_topic"},
  {"at": 6.0, "quit": true}
]

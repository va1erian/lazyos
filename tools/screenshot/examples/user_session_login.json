[
  {"wait_for": "LazyOS login: ", "timeout": 300},
  {"type": "user", "delay": 0.0},
  {"key": "enter"},
  {"type": "lazy", "delay": 0.0},
  {"key": "enter", "until": "LOGIN:GRAPHICAL:PASS user=user", "timeout": 60},
  {"wait_for": "THEME:USER uid=1000", "timeout": 120},
  {"wait": 10.0},
  {"shot": "01_user_desktop"},
  {"at": 1.0, "click_at": {"target": "taskbar:start"}, "until": "SHELL:MENU:OPEN", "timeout": 30, "retries": 2},
  {"at": 1.0, "move_to": {"menu": "Graphics"}, "until": "SHELL:SUBMENU:OPEN category=graphics", "timeout": 30, "retries": 1},
  {"at": 2.0, "shot": "02_user_graphics"},
  {"at": 1.0, "move_to": {"menu": "Accessories"}, "until": "SHELL:SUBMENU:OPEN category=accessories", "timeout": 30, "retries": 1},
  {"at": 2.0, "shot": "03_user_accessories"},
  {"at": 1.0, "key": "esc"},
  {"at": 1.0, "click_at": {"window": "Terminal"}, "note": "focus the Terminal"},
  {"at": 1.0, "type": "confctl set user/1000/ui/mode str dark"},
  {"key": "enter", "until": "THEME:APPLIED", "occurrence": 2, "timeout": 30, "retries": 1},
  {"at": 2.0, "shot": "04_user_dark_live"},
  {"at": 0.5, "type": "confctl set user/1000/ui/mode str light"},
  {"key": "enter", "until": "THEME:APPLIED", "occurrence": 3, "timeout": 30, "retries": 1},
  {"at": 2.0, "type": "sync"},
  {"at": 0.5, "key": "enter"},
  {"at": 7.0, "quit": true}
]

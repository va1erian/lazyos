Do not use AVX the OS has not enabled (MacroAssemblerX86_64.cpp).

collectCPUFeatures() takes AVX from CPUID.1:ECX bit 28 alone. A VEX-encoded
instruction is #UD unless the OS set CR4.OSXSAVE and enabled the SSE and YMM
state in XCR0, which Intel's SDM says software must check (OSXSAVE, then
XGETBV). LazyOS enables no AVX state, so a CPU that reports AVX (every WHPX or
KVM guest on a modern host) made the JIT emit VEX code that raised SIGILL.
AVX2 follows AVX. WebKitGTK 2.54.1 as released.

--- a/Source/JavaScriptCore/assembler/MacroAssemblerX86_64.cpp
+++ b/Source/JavaScriptCore/assembler/MacroAssemblerX86_64.cpp
@@ -496,6 +496,20 @@
     return result;
 }
 
+// AVX needs the OS to have turned it on, not only the CPU to have it: CPUID
+// reports the CPU's AVX bit, but a VEX-encoded instruction is #UD unless
+// CR4.OSXSAVE is set (CPUID.1:ECX bit 27) and XCR0 enables the SSE and YMM
+// state (bits 1 and 2, read with XGETBV). Intel's SDM prescribes this check.
+static bool operatingSystemEnablesAVX(unsigned cpuidLeaf1ECX)
+{
+    if (!(cpuidLeaf1ECX & (1u << 27)))
+        return false;
+    unsigned xcr0Low;
+    unsigned xcr0High;
+    __asm__ volatile("xgetbv" : "=a"(xcr0Low), "=d"(xcr0High) : "c"(0));
+    return (xcr0Low & 6u) == 6u;
+}
+
 void MacroAssemblerX86_64::collectCPUFeatures()
 {
     static std::once_flag onceKey;
@@ -510,7 +524,7 @@
 #if OS(DARWIN)
             s_avxCheckState = CPUIDCheckState::Set;
 #else
-            s_avxCheckState = (cpuid[2] & (1 << 28)) ? CPUIDCheckState::Set : CPUIDCheckState::Clear;
+            s_avxCheckState = ((cpuid[2] & (1 << 28)) && operatingSystemEnablesAVX(cpuid[2])) ? CPUIDCheckState::Set : CPUIDCheckState::Clear;
 #endif
         }
 #if OS(DARWIN)
@@ -527,7 +541,7 @@
         {
             CPUID cpuid = getCPUID(0x7);
             s_bmi1CheckState = (cpuid[2] & (1 << 3)) ? CPUIDCheckState::Set : CPUIDCheckState::Clear;
-            s_avx2CheckState = (cpuid[2] & (1 << 5)) ? CPUIDCheckState::Set : CPUIDCheckState::Clear;
+            s_avx2CheckState = ((cpuid[2] & (1 << 5)) && s_avxCheckState == CPUIDCheckState::Set) ? CPUIDCheckState::Set : CPUIDCheckState::Clear;
         }
 #endif

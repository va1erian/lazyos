}

// The variants of `Role`, in wire order.
export const ROLE = ["Window", "Desktop", "Panel", "Popup"];

export const ROLE_WINDOW = "Window";

export const ROLE_DESKTOP = "Desktop";

export const ROLE_PANEL = "Panel";

export const ROLE_POPUP = "Popup";

// The variants of `Change`, in wire order.
export const CHANGE = ["Unspecified", "Created", "Destroyed", "Moved", "Minimized", "Restored", "Title", "Resized", "Maximized", "Unmaximized"];

export const CHANGE_UNSPECIFIED = "Unspecified";

export const CHANGE_CREATED = "Created";

export const CHANGE_DESTROYED = "Destroyed";

export const CHANGE_MOVED = "Moved";

export const CHANGE_MINIMIZED = "Minimized";

export const CHANGE_RESTORED = "Restored";

export const CHANGE_TITLE = "Title";

export const CHANGE_RESIZED = "Resized";

export const CHANGE_MAXIMIZED = "Maximized";

export const CHANGE_UNMAXIMIZED = "Unmaximized";

// The variants of `WindowState`, in wire order.
export const WINDOW_STATE = ["Normal", "Maximized"];

export const WINDOW_STATE_NORMAL = "Normal";

export const WINDOW_STATE_MAXIMIZED = "Maximized";
